@model MacharPos.Web.ViewModels.DailyClose.DailyCloseVm
@{
    ViewData["Title"] = "Daily Close";
    var isClosed = Model.Existing?.IsClosed ?? false;
    var hasTankClosing = Model.Existing?.TankClosingKg.HasValue ?? false;
}

<div class="no-print d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h5 mb-0">Daily Close / Reconciliation</h1>
        <div class="text-secondary small">Station: <span class="fw-semibold">@Model.StationName</span></div>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-dark btn-sm" onclick="window.print()">Print</button>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success no-print">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger no-print">@err</div>
}

<div class="card shadow-sm mb-3 no-print">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">Date</label>
                <input class="form-control" type="date" name="date" value="@Model.CloseDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3">
                <button class="btn btn-outline-primary w-100">Load</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <div class="fw-semibold">Business Date: @Model.CloseDate.ToString("yyyy-MM-dd")</div>
                @if (isClosed)
                {
                    <div class="small text-success">Status: CLOSED</div>
                    @if (Model.Existing?.ClosedAtUtc != null)
                    {
                        <div class="small text-secondary">Closed at (UTC): @Model.Existing.ClosedAtUtc!.Value.ToString("yyyy-MM-dd HH:mm")</div>
                    }
                }
                else
                {
                    <div class="small text-warning">Status: OPEN (not closed yet)</div>
                }
            </div>
            <div>
                @if (isClosed)
                {
                    <span class="badge text-bg-success">Closed</span>
                }
                else
                {
                    <span class="badge text-bg-warning">Open</span>
                }
            </div>
        </div>

        <hr />

        <div class="row g-3">
            <!-- LIVE -->
            <div class="col-12 col-lg-6">
                <div class="border rounded p-3">
                    <div class="text-secondary small">LIVE (recomputed)</div>

                    <div class="d-flex justify-content-between mt-2">
                        <div>Total Sales (incl. credit)</div>
                        <div class="fw-semibold">₦@Model.LiveTotalSales.ToString("N2")</div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>Transactions</div>
                        <div class="fw-semibold">@Model.LiveTotalTransactions</div>
                    </div>

                    <hr />
                    <div class="text-secondary small">MONEY COLLECTED TODAY</div>
                    <div class="d-flex justify-content-between mt-2"><div>Cash</div><div class="fw-semibold">₦@Model.LiveCashTotal.ToString("N2")</div></div>
                    <div class="d-flex justify-content-between"><div>POS</div><div class="fw-semibold">₦@Model.LivePosTotal.ToString("N2")</div></div>
                    <div class="d-flex justify-content-between"><div>Transfer</div><div class="fw-semibold">₦@Model.LiveTransferTotal.ToString("N2")</div></div>

                    <hr />
                    <div class="text-secondary small">CREDIT</div>
                    <div class="d-flex justify-content-between mt-2"><div>Credit Issued Today</div><div class="fw-semibold">₦@Model.LiveCreditIssuedTotal.ToString("N2")</div></div>
                    <div class="d-flex justify-content-between"><div>Credit Collected Today</div><div class="fw-semibold">₦@Model.LiveCreditCollectedTotal.ToString("N2")</div></div>

                    <div class="small text-secondary mt-2">Credit collected breakdown</div>
                    <div class="d-flex justify-content-between"><div>Cash</div><div class="fw-semibold">₦@Model.LiveCreditCollectedCash.ToString("N2")</div></div>
                    <div class="d-flex justify-content-between"><div>POS</div><div class="fw-semibold">₦@Model.LiveCreditCollectedPos.ToString("N2")</div></div>
                    <div class="d-flex justify-content-between"><div>Transfer</div><div class="fw-semibold">₦@Model.LiveCreditCollectedTransfer.ToString("N2")</div></div>

                    <hr />
                    <div class="d-flex justify-content-between"><div>Total LPG Sold</div><div class="fw-semibold">@Model.LiveTotalLpgKg.ToString("N2") kg</div></div>
                    <div class="d-flex justify-content-between"><div>Active Batch Remaining</div><div class="fw-semibold">@Model.LiveActiveBatchRemainingKg.ToString("N2") kg</div></div>

                    <!-- NEW: LIVE TANK SCALE RECON (no-print preview) -->
                    <hr />
                    <div class="text-secondary small">LPG TANK SCALE (preview)</div>
                    <div class="d-flex justify-content-between mt-2">
                        <div>Opening (from last close)</div>
                        <div class="fw-semibold">@Model.LiveTankOpeningKg.ToString("N2") kg</div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>Receipts Today</div>
                        <div class="fw-semibold">@((Model.TankReceiptsKg ?? 0m).ToString("N2")) kg</div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>Closing (entered)</div>
                        <div class="fw-semibold">@((Model.TankClosingKg ?? 0m).ToString("N2")) kg</div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>Scale Sold</div>
                        <div class="fw-semibold">@Model.LiveTankScaleSoldKg.ToString("N2") kg</div>
                    </div>
                    <div class="d-flex justify-content-between">
                        <div>Variance (Scale - App)</div>
                        <div class="fw-semibold">@Model.LiveTankVarianceKg.ToString("N2") kg</div>
                    </div>
                    <div class="form-text">Variance helps spot missing sales, scale drift, or posting errors.</div>
                </div>
            </div>

            <!-- SAVED SNAPSHOT -->
            <div class="col-12 col-lg-6">
                <div class="border rounded p-3">
                    <div class="text-secondary small">SAVED SNAPSHOT (after close)</div>

                    @if (Model.Existing is null)
                    {
                        <div class="mt-2 text-secondary">No saved close record yet for this date.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between mt-2"><div>Total Sales (incl. credit)</div><div class="fw-semibold">₦@Model.Existing.TotalSales.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>Transactions</div><div class="fw-semibold">@Model.Existing.TotalTransactions</div></div>

                        <hr />
                        <div class="text-secondary small">MONEY COLLECTED TODAY</div>
                        <div class="d-flex justify-content-between mt-2"><div>Cash</div><div class="fw-semibold">₦@Model.Existing.CashTotal.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>POS</div><div class="fw-semibold">₦@Model.Existing.PosTotal.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>Transfer</div><div class="fw-semibold">₦@Model.Existing.TransferTotal.ToString("N2")</div></div>

                        <hr />
                        <div class="text-secondary small">CREDIT</div>
                        <div class="d-flex justify-content-between mt-2"><div>Credit Issued Today</div><div class="fw-semibold">₦@Model.Existing.CreditIssuedTotal.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>Credit Collected Today</div><div class="fw-semibold">₦@Model.Existing.CreditCollectedTotal.ToString("N2")</div></div>

                        <div class="small text-secondary mt-2">Credit collected breakdown</div>
                        <div class="d-flex justify-content-between"><div>Cash</div><div class="fw-semibold">₦@Model.Existing.CreditCollectedCash.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>POS</div><div class="fw-semibold">₦@Model.Existing.CreditCollectedPos.ToString("N2")</div></div>
                        <div class="d-flex justify-content-between"><div>Transfer</div><div class="fw-semibold">₦@Model.Existing.CreditCollectedTransfer.ToString("N2")</div></div>

                        <hr />
                        <div class="d-flex justify-content-between"><div>Total LPG Sold</div><div class="fw-semibold">@Model.Existing.TotalLpgKg.ToString("N2") kg</div></div>
                        <div class="d-flex justify-content-between"><div>Active Batch Remaining</div><div class="fw-semibold">@Model.Existing.ActiveBatchRemainingKg.ToString("N2") kg</div></div>

                        <!-- NEW: SAVED TANK SCALE RECON -->
                        @if (Model.Existing.TankClosingKg.HasValue)
                        {
                            <hr />
                            <div class="text-secondary small">LPG TANK SCALE (saved)</div>
                            <div class="d-flex justify-content-between mt-2">
                                <div>Opening</div>
                                <div class="fw-semibold">@((Model.Existing.TankOpeningKg ?? 0m).ToString("N2")) kg</div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>Receipts</div>
                                <div class="fw-semibold">@Model.Existing.TankReceiptsKg?.ToString("N2") kg</div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>Closing</div>
                                <div class="fw-semibold">@Model.Existing.TankClosingKg.Value.ToString("N2") kg</div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>Scale Sold</div>
                                <div class="fw-semibold">@((Model.Existing.TankScaleSoldKg ?? 0m).ToString("N2")) kg</div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>Variance (Scale - App)</div>
                                <div class="fw-semibold">@((Model.Existing.TankVarianceKg ?? 0m).ToString("N2")) kg</div>
                            </div>
                        }

                        @if (Model.Existing.CashCounted.HasValue)
                        {
                            <hr />
                            <div class="d-flex justify-content-between"><div>Cash Counted</div><div class="fw-semibold">₦@Model.Existing.CashCounted.Value.ToString("N2")</div></div>
                            <div class="d-flex justify-content-between"><div>Cash Variance</div><div class="fw-semibold">₦@(Model.Existing.CashVariance ?? 0m).ToString("N2")</div></div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Existing.Notes))
                        {
                            <hr />
                            <div class="small text-secondary">Notes</div>
                            <div>@Model.Existing.Notes</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Existing.ModificationReason))
                        {
                            <hr />
                            <div class="small text-secondary">Modified by SuperAdmin</div>
                            <div class="small">Reason: <span class="fw-semibold">@Model.Existing.ModificationReason</span></div>
                            <div class="small text-secondary">At (UTC): @Model.Existing.ModifiedAtUtc?.ToString("yyyy-MM-dd HH:mm")</div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="no-print">
            <hr />

            @if (!(Model.Existing?.IsClosed ?? false))
            {
                @if (User.IsInRole("StationManager") || User.IsInRole("Admin"))
                {
                    <form asp-action="CloseDay" method="post" class="row g-2" id="closeDayForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="closeDate" value="@Model.CloseDate.ToString("yyyy-MM-dd")" />

                        <!-- NEW: Tank scale inputs -->
                        <div class="col-12">
                            <div class="border rounded p-3 bg-light">
                                <div class="fw-semibold">LPG Tank Scale</div>
                                <div class="small text-secondary">Enter today’s closing tank scale (kg). Opening is auto from last closed day.</div>

                                <div class="row g-2 mt-1">
                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Opening (auto)</label>
                                        <input class="form-control" value="@Model.LiveTankOpeningKg.ToString("N2")" readonly />
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Receipts Today (kg) (optional)</label>
                                        <input class="form-control" type="number" step="0.01" name="tankReceiptsKg" value="@(Model.TankReceiptsKg?.ToString() ?? "")" />
                                    </div>

                                    <div class="col-12 col-md-4">
                                        <label class="form-label">Closing Tank Scale (kg) <span class="text-danger">*</span></label>
                                        <input class="form-control" type="number" step="0.01" name="tankClosingKg" value="@(Model.TankClosingKg?.ToString() ?? "")" required />
                                        <div class="form-text">Required to close the day.</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Cash Counted (optional)</label>
                            <input class="form-control" type="number" step="0.01" name="cashCounted" value="@(Model.CashCounted?.ToString() ?? "")" />
                        </div>

                        <div class="col-12 col-md-8">
                            <label class="form-label">Notes (optional)</label>
                            <input class="form-control" name="notes" value="@(Model.Notes ?? "")" placeholder="e.g. credit sale entered late..." />
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-dark w-100">Close Day</button>
                            <div class="form-text">Locks the day. Only SuperAdmin can change it later.</div>
                        </div>
                    </form>

                    <!-- OPTIONAL: Last 14 days history table (still same screen) -->
                    @if (Model.TankHistory?.Any() == true)
                    {
                        <hr />
                        <div class="border rounded p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-semibold">Tank vs App History (Last @Model.TankHistory.Count days)</div>
                            </div>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th class="text-end">Opening</th>
                                            <th class="text-end">Receipts</th>
                                            <th class="text-end">Closing</th>
                                            <th class="text-end">App Sold</th>
                                            <th class="text-end">Scale Sold</th>
                                            <th class="text-end">Variance</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in Model.TankHistory)
                                        {
                                            <tr>
                                                <td>@r.CloseDate.ToString("yyyy-MM-dd")</td>
                                                <td class="text-end">@((r.OpeningKg ?? 0m).ToString("N2"))</td>
                                                <td class="text-end">@r.ReceiptsKg.ToString("N2")</td>
                                                <td class="text-end">@((r.ClosingKg ?? 0m).ToString("N2"))</td>
                                                <td class="text-end">@r.AppSoldKg.ToString("N2")</td>
                                                <td class="text-end">@((r.ScaleSoldKg ?? 0m).ToString("N2"))</td>
                                                <td class="text-end">@((r.VarianceKg ?? 0m).ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text">Variance = Scale Sold − App Sold.</div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">Only StationManager/Admin can close the day.</div>
                }
            }
            else
            {
                @if (User.IsInRole("SuperAdmin"))
                {
                    <form asp-action="SuperRecalculate" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="closeDate" value="@Model.CloseDate.ToString("yyyy-MM-dd")" />

                        <div class="col-12 col-md-6">
                            <label class="form-label">Modification Reason (required)</label>
                            <input class="form-control" name="reason" required />
                        </div>

                        <div class="col-12 col-md-3">
                            <label class="form-label">Cash Counted (optional)</label>
                            <input class="form-control" type="number" step="0.01" name="cashCounted" />
                        </div>

                        <div class="col-12 col-md-3 d-flex align-items-end">
                            <button class="btn btn-outline-danger w-100">Recalculate & Update</button>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Notes (optional)</label>
                            <input class="form-control" name="notes" />
                        </div>

                        <!-- OPTIONAL: allow SuperAdmin to adjust tank values -->
                        <div class="col-12">
                            <div class="border rounded p-3 bg-light">
                                <div class="fw-semibold">LPG Tank Scale (optional)</div>
                                <div class="small text-secondary">Leave blank to keep current tank values. Enter closing to update tank reconciliation.</div>

                                <div class="row g-2 mt-1">
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Receipts Today (kg) (optional)</label>
                                        <input class="form-control" type="number" step="0.01" name="tankReceiptsKg" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label">Closing Tank Scale (kg) (optional)</label>
                                        <input class="form-control" type="number" step="0.01" name="tankClosingKg" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-secondary">Day is closed. Only SuperAdmin can modify after close.</div>
                }
            }
        </div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            margin: 0;
        }

        .card {
            box-shadow: none !important;
        }
    }
</style>
@section Scripts {
<script>
    (function () {
        const form = document.getElementById("closeDayForm");
        if (!form) return;

        form.addEventListener("submit", function (e) {
            const closeDateInput = form.querySelector('input[name="closeDate"]');
            if (!closeDateInput || !closeDateInput.value) return;

            const parts = closeDateInput.value.split("-");
            if (parts.length !== 3) return;

            const year = parseInt(parts[0], 10);
            const month = parseInt(parts[1], 10) - 1;
            const day = parseInt(parts[2], 10);

            const date = new Date(year, month, day);

            const formattedDate = date.toLocaleDateString("en-GB", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric"
            });

            const ok = window.confirm(
                `Are you sure you want to close sales for ${formattedDate}?\n\nThis will lock the day.`
            );

            if (!ok) {
                e.preventDefault();
            }
        });
    })();
</script>
}