@model MacharPos.Web.ViewModels.Credit.CreditSaleCreateVm
@using MacharPos.Core.Entities
@using MacharPos.Web.ViewModels.Sales

@{
    ViewData["Title"] = "New Credit Sale";

    var productPrices = ViewBag.ProductPrices as Dictionary<string, decimal>
                      ?? new Dictionary<string, decimal>();

    var productEquivalentKgs = ViewBag.ProductEquivalentKgs as Dictionary<string, decimal>
                            ?? new Dictionary<string, decimal>();
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h5 mb-0">New Credit Sale</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" id="creditSaleForm">
            @Html.AntiForgeryToken()

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="form-label">Customer</label>
                    <select class="form-select" asp-for="CustomerId" asp-items="Model.Customers"></select>
                    <div class="form-text">Only credit-approved customers can complete a credit sale.</div>
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Due Date (optional)</label>
                    <input class="form-control" asp-for="DueDate" type="date" />
                </div>

                <div class="col-12 col-md-3">
                    <label class="form-label">Notes (optional)</label>
                    <input class="form-control" asp-for="Notes" placeholder="e.g. pay next week" />
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex align-items-center justify-content-between">
                <div class="fw-semibold">Items</div>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="addLine()">Add Line</button>
            </div>

            <div class="table-responsive mt-2">
                <table class="table table-sm align-middle" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:260px;">Product</th>
                            <th style="width:140px;">Mode</th>
                            <th style="width:110px;">Qty (Cyl)</th>
                            <th style="width:110px;">Kg</th>
                            <th style="width:140px;">Amount (₦)</th>
                            <th style="width:140px;">Unit Price</th>
                            <th class="text-end" style="width:160px;">Line Total</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select class="form-select product-select" name="Lines[@i].ProductId" onchange="onProductChange(this)">
                                        <option value="">Select...</option>
                                        @foreach (var p in Model.Products)
                                        {
                                            var price = productPrices.TryGetValue(p.Value, out var pv) ? pv : 0m;
                                            var eqKg = productEquivalentKgs.TryGetValue(p.Value, out var ev) ? ev : 0m;
                                            var selected = Model.Lines[i].ProductId != Guid.Empty && Model.Lines[i].ProductId.ToString() == p.Value;

                                            if (selected)
                                            {
                                                <option value="@p.Value" data-price="@price" data-eqkg="@eqKg" selected>@p.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@p.Value" data-price="@price" data-eqkg="@eqKg">@p.Text</option>
                                            }
                                        }
                                    </select>
                                </td>

                                <td>
                                    <select class="form-select mode-select" name="Lines[@i].EntryMode" onchange="onModeChange(this)">
                                        @if (Model.Lines[i].EntryMode == SaleEntryMode.ByAmount)
                                        {
                                            <option value="1">By Kg</option>
                                            <option value="2" selected>By Amount</option>
                                        }
                                        else
                                        {
                                            <option value="1" selected>By Kg</option>
                                            <option value="2">By Amount</option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input class="form-control qty-input" name="Lines[@i].Qty" type="number" step="1" min="1" value="@(Model.Lines[i].Qty <= 0 ? 1 : Model.Lines[i].Qty)" oninput="calcTotals()" />
                                </td>

                                <td>
                                    <input class="form-control kg-input" name="Lines[@i].Kg" type="number" step="0.01" value="@(Model.Lines[i].Kg?.ToString("0.##") ?? "")" readonly />
                                </td>

                                <td>
                                    <input class="form-control amount-input" name="Lines[@i].Amount" type="number" step="0.01" value="@(Model.Lines[i].Amount?.ToString("0.##") ?? "")" oninput="calcTotals()" />
                                </td>

                                <td>
                                    <input class="form-control price-input" name="Lines[@i].UnitPrice" type="number" step="0.01" value="@Model.Lines[i].UnitPrice" readonly />
                                </td>

                                <td class="text-end">
                                    <span class="lineTotal">0.00</span>
                                </td>

                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLine(this)">×</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Initial Payment (optional)</label>
                    <input class="form-control" asp-for="InitialPaymentAmount" type="number" step="0.01" value="@Model.InitialPaymentAmount" oninput="calcTotals()" />
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">Initial Payment Method</label>
                    <select class="form-select" asp-for="InitialPaymentMethod" asp-items="Model.PaymentMethods"></select>
                </div>

                <div class="col-12 col-md-4">
                    <label class="form-label">Credit Balance</label>
                    <input class="form-control" id="balanceBox" type="text" readonly value="0.00" />
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <div class="fs-6">
                    Total: <span class="fw-semibold">₦<span id="grandTotal">0.00</span></span>
                </div>
            </div>

            <button class="btn btn-dark w-100 mt-3">Create Credit Sale</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function onProductChange(sel) {
            const opt = sel.options[sel.selectedIndex];
            const price = parseFloat(opt?.getAttribute("data-price") || "0");
            const row = sel.closest("tr");

            row.querySelector('input[name$=".UnitPrice"]').value = price.toFixed(2);
            onModeChange(row.querySelector('select[name$=".EntryMode"]'));
            calcTotals();
        }

        function onModeChange(sel) {
            const row = sel.closest("tr");
            const mode = sel.value;
            const qtyInput = row.querySelector('input[name$=".Qty"]');
            const amountInput = row.querySelector('input[name$=".Amount"]');

            if (mode === "2") {
                amountInput.readOnly = false;
                amountInput.placeholder = "Enter amount";
                if (!qtyInput.value || parseFloat(qtyInput.value) <= 0) qtyInput.value = "1";
            } else {
                amountInput.readOnly = true;
                amountInput.placeholder = "Auto";
            }

            calcTotals();
        }

        function addLine() {
            const tbody = document.querySelector("#linesTable tbody");
            const idx = tbody.querySelectorAll("tr").length;

            const row = document.createElement("tr");
            row.innerHTML = `
                <td>
                    <select class="form-select product-select" name="Lines[${idx}].ProductId" onchange="onProductChange(this)">
                        <option value="">Select...</option>
                        ${getProductsOptionsHtml()}
                    </select>
                </td>
                <td>
                    <select class="form-select mode-select" name="Lines[${idx}].EntryMode" onchange="onModeChange(this)">
                        <option value="1" selected>By Kg</option>
                        <option value="2">By Amount</option>
                    </select>
                </td>
                <td><input class="form-control qty-input" name="Lines[${idx}].Qty" type="number" step="1" min="1" value="1" oninput="calcTotals()" /></td>
                <td><input class="form-control kg-input" name="Lines[${idx}].Kg" type="number" step="0.01" value="" readonly /></td>
                <td><input class="form-control amount-input" name="Lines[${idx}].Amount" type="number" step="0.01" value="" readonly placeholder="Auto" oninput="calcTotals()" /></td>
                <td><input class="form-control price-input" name="Lines[${idx}].UnitPrice" type="number" step="0.01" value="0" readonly /></td>
                <td class="text-end"><span class="lineTotal">0.00</span></td>
                <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLine(this)">×</button></td>
            `;

            tbody.appendChild(row);
            calcTotals();
        }

        function removeLine(btn) {
            const tbody = document.querySelector("#linesTable tbody");
            btn.closest("tr").remove();

            const rows = tbody.querySelectorAll("tr");
            rows.forEach((r, idx) => {
                r.querySelectorAll("select, input").forEach(el => {
                    if (el.name) el.name = el.name.replace(/Lines\[\d+\]/, `Lines[${idx}]`);
                });
            });

            calcTotals();
        }

        function calcTotals() {
            const rows = document.querySelectorAll("#linesTable tbody tr");
            let grand = 0;

            rows.forEach(r => {
                const mode = r.querySelector('select[name$=".EntryMode"]')?.value || "1";
                const productSelect = r.querySelector('select[name$=".ProductId"]');
                const selectedOpt = productSelect?.options[productSelect.selectedIndex];

                const eqKg = parseFloat(selectedOpt?.getAttribute("data-eqkg") || "0");
                const qtyInput = r.querySelector('input[name$=".Qty"]');
                const kgInput = r.querySelector('input[name$=".Kg"]');
                const amountInput = r.querySelector('input[name$=".Amount"]');
                const priceInput = r.querySelector('input[name$=".UnitPrice"]');

                const qty = parseFloat(qtyInput?.value || "0");
                const amount = parseFloat(amountInput?.value || "0");
                const price = parseFloat(priceInput?.value || "0");

                let total = 0;

                if (mode === "2") {
                    total = amount || 0;

                    if (price > 0 && amount > 0) {
                        kgInput.value = (amount / price).toFixed(2);
                    } else {
                        kgInput.value = "";
                    }

                    if (!qtyInput.value || parseFloat(qtyInput.value) <= 0) {
                        qtyInput.value = "1";
                    }
                } else {
                    if (eqKg > 0 && qty > 0) {
                        kgInput.value = (qty * eqKg).toFixed(2);
                    } else {
                        kgInput.value = "";
                    }

                    total = (qty * price) || 0;

                    if (qty > 0 && price > 0) {
                        amountInput.value = total.toFixed(2);
                    } else {
                        amountInput.value = "";
                    }
                }

                r.querySelector(".lineTotal").innerText = total.toFixed(2);
                grand += total;
            });

            document.getElementById("grandTotal").innerText = grand.toFixed(2);

            const initialPaid = parseFloat(document.querySelector('[name="InitialPaymentAmount"]')?.value || "0");
            const balance = Math.max(0, grand - (initialPaid || 0));
            document.getElementById("balanceBox").value = balance.toFixed(2);
        }

        function getProductsOptionsHtml() {
            const opts = [];
            @foreach (var p in Model.Products)
            {
                    var price = productPrices.TryGetValue(p.Value, out var pv) ? pv : 0m;
                    var eqKg = productEquivalentKgs.TryGetValue(p.Value, out var ev) ? ev : 0m;
                    <text>opts.push(`<option value="@p.Value" data-price="@price" data-eqkg="@eqKg">@p.Text</option>`);</text>
            }
            return opts.join("");
        }

        document.querySelectorAll('#linesTable tbody tr').forEach(row => {
            const productSelect = row.querySelector('select[name$=".ProductId"]');
            if (productSelect && productSelect.value) onProductChange(productSelect);
            const modeSelect = row.querySelector('select[name$=".EntryMode"]');
            if (modeSelect) onModeChange(modeSelect);
        });

        calcTotals();
    </script>
}
