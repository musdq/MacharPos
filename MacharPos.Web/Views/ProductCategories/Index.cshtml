@model List<MacharPos.Core.Entities.ProductCategory>
@{
    ViewData["Title"] = "Product Categories";
}
<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h5 mb-0">Product Categories</h1>
  <a class="btn btn-outline-secondary btn-sm" asp-controller="Products" asp-action="Index">Go to Products</a>
</div>
@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Err"] is string err) { <div class="alert alert-danger">@err</div> }
<div class="card shadow-sm">
  <div class="card-body">
    <form class="row g-2" asp-action="Create" method="post">
      @Html.AntiForgeryToken()
      <div class="col-12 col-md-8">
        <input class="form-control" name="name" placeholder="New category name" />
      </div>
      <div class="col-12 col-md-4">
        <button class="btn btn-dark w-100">Add Category</button>
      </div>
    </form>
    <div class="table-responsive mt-3">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Status</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var c in Model)
          {
            <tr>
              <td>@c.Name</td>
              <td>
                @if (c.IsActive) { <span class="badge text-bg-success">Active</span> }
                else { <span class="badge text-bg-secondary">Inactive</span> }
              </td>
              <td class="text-end">
                <form asp-action="Toggle" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@c.Id" />
                  @if (c.IsActive)
                  {
                    <button class="btn btn-outline-danger btn-sm">Deactivate</button>
                  }
                  else
                  {
                    <button class="btn btn-outline-success btn-sm">Activate</button>
                  }
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>