@model List<MacharPos.Core.Entities.Product>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Products";

    Guid? categoryId = (Guid?)ViewBag.CategoryId;
    Guid? stationId = (Guid?)ViewBag.StationId;
    bool showInactive = (bool)ViewBag.ShowInactive;

    var categorySource = (SelectList)ViewBag.Categories;
    var stationSource = (SelectList)ViewBag.Stations;

    // Ensure the selected filters remain selected after reloading the page.
    var categories = new SelectList(
        categorySource.Items,
        categorySource.DataValueField,
        categorySource.DataTextField,
        categoryId);

    var stations = new SelectList(
        stationSource.Items,
        stationSource.DataValueField,
        stationSource.DataTextField,
        stationId);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h5 mb-0">Products</h1>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm"
           asp-controller="ProductCategories"
           asp-action="Index">
            Categories
        </a>

        <a class="btn btn-dark btn-sm"
           asp-action="Create">
            Add Product
        </a>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <!-- FILTER FORM -->
        <form method="get"
              asp-action="Index"
              class="row g-2 align-items-end mb-3">

            <div class="col-12 col-md-4">
                <label for="stationFilter" class="form-label">
                    Station
                </label>

                <select class="form-select"
                        id="stationFilter"
                        name="stationId"
                        asp-items="stations">
                    <option value="">All stations</option>
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label for="categoryFilter" class="form-label">
                    Category
                </label>

                <select class="form-select"
                        id="categoryFilter"
                        name="categoryId"
                        asp-items="categories">
                    <option value="">All categories</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input"
                           type="checkbox"
                           id="showInactiveFilter"
                           name="showInactive"
                           value="true"
                    @(showInactive ? "checked" : null) />

                    <label class="form-check-label"
                           for="showInactiveFilter">
                        Show inactive
                    </label>
                </div>
            </div>

            <div class="col-12 col-md-2">
                <button class="btn btn-outline-primary w-100"
                        type="submit">
                    Filter
                </button>
            </div>
        </form>

        <hr />

        <!-- BULK PRICE UPDATE FORM -->
        <form asp-action="BulkUpdatePrices"
              method="post"
              id="bulkPriceForm"
              class="row g-2 align-items-end mb-3">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="bulkStationId"
                   name="stationId"
                   value="@stationId" />

            <input type="hidden"
                   id="bulkCategoryId"
                   name="categoryId"
                   value="@categoryId" />

            <input type="hidden"
                   id="bulkShowInactive"
                   name="showInactive"
                   value="@showInactive.ToString().ToLowerInvariant()" />

            <div class="col-12 col-md-4">
                <label for="pricePerKg" class="form-label">
                    LPG Price per Kg
                </label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       name="pricePerKg"
                       id="pricePerKg"
                       class="form-control"
                       placeholder="e.g. 1035"
                       required />
            </div>

            <div class="col-12 col-md-auto">
                <button type="submit"
                        id="bulkUpdateButton"
                        class="btn btn-danger">
                    Update Selected Station Prices
                </button>
            </div>

            <div class="col-12">
                <small id="stationRequiredMessage"
                       class="text-muted">
                    Select a station above before running a bulk price update.
                    You do not need to click Filter first.
                </small>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Category</th>
                        <th>Name</th>
                        <th class="text-end">Default Price</th>
                        <th class="text-end">Kg (if LPG)</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                No products were found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    @(product.Station?.Name ?? "-")
                                </td>

                                <td>
                                    @(product.Category?.Name ?? "-")
                                </td>

                                <td class="text-break">
                                    @product.Name
                                </td>

                                <td class="text-end">
                                    @product.DefaultUnitPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @if ((product.EquivalentKg ?? 0m) == 0m)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        <span>
                                            @product.EquivalentKg!.Value.ToString("N2")
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge text-bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a class="btn btn-outline-secondary btn-sm"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id">
                                            Edit
                                        </a>

                                        <a class="btn btn-danger btn-sm"
                                           asp-action="Delete"
                                           asp-route-id="@product.Id">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stationFilter =
                document.getElementById("stationFilter");

            const categoryFilter =
                document.getElementById("categoryFilter");

            const showInactiveFilter =
                document.getElementById("showInactiveFilter");

            const bulkPriceForm =
                document.getElementById("bulkPriceForm");

            const bulkStationId =
                document.getElementById("bulkStationId");

            const bulkCategoryId =
                document.getElementById("bulkCategoryId");

            const bulkShowInactive =
                document.getElementById("bulkShowInactive");

            function synchronizeBulkForm() {
                bulkStationId.value = stationFilter.value;
                bulkCategoryId.value = categoryFilter.value;
                bulkShowInactive.value =
                    showInactiveFilter.checked ? "true" : "false";
            }

            stationFilter.addEventListener(
                "change",
                synchronizeBulkForm
            );

            categoryFilter.addEventListener(
                "change",
                synchronizeBulkForm
            );

            showInactiveFilter.addEventListener(
                "change",
                synchronizeBulkForm
            );

            bulkPriceForm.addEventListener("submit", function (event) {
                synchronizeBulkForm();

                if (!bulkStationId.value) {
                    event.preventDefault();

                    alert(
                        "Please select a station before updating prices."
                    );

                    stationFilter.focus();
                }
            });

            synchronizeBulkForm();
        });
    </script>
}