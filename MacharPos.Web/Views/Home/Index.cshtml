@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3">
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Today</div>
                <div class="fs-4 fw-semibold">₦0</div>
                <div class="small text-secondary">Sales total (we’ll wire this next)</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Transactions</div>
                <div class="fs-4 fw-semibold">0</div>
                <div class="small text-secondary">Count</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Active LPG Batch</div>
                <div class="fs-6 fw-semibold">None</div>
                <div class="small text-secondary">For your station</div>
            </div>
        </div>
    </div>
</div>
