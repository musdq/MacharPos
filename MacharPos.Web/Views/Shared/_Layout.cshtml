@using Microsoft.AspNetCore.Identity
@inject SignInManager<MacharPos.Web.Auth.ApplicationUser> SignInManager
@{
    var isSignedIn = SignInManager.IsSignedIn(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Machar Oil and Gas Ltd</title>
    <meta name="description" content="Machar Oil and Gas Ltd provides PMS, LPG, AGO logistics, retail and consulting services across Nigeria." />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(isSignedIn ? "portal-body" : "public-body")">
    @if (isSignedIn)
    {
        <header class="no-print">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
                <div class="container-fluid">
                    <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">Machar POS</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                            </li>

                            @* Sales *@
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navSalesDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Sales
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navSalesDropdown">
                                    <li><a class="dropdown-item" asp-controller="Sales" asp-action="New">New Sale</a></li>
                                    <li><a class="dropdown-item" asp-controller="Sales" asp-action="Index">Sales</a></li>
                                </ul>
                            </li>

                            @* Credit *@
                            @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navCreditDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Credit
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navCreditDropdown">
                                        <li><a class="dropdown-item" asp-controller="Credit" asp-action="New">New Credit Sale</a></li>
                                        <li><a class="dropdown-item" asp-controller="Credit" asp-action="Index">Credit Sales</a></li>
                                        @* <li><a class="dropdown-item" asp-controller="Credit" asp-action="Aging">Credit Aging</a></li> *@
                                    </ul>
                                </li>
                            }

                            @* Expenses: show a direct link when only one option is available. *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navExpensesDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Expenses
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navExpensesDropdown">
                                        <li><a class="dropdown-item" asp-controller="Expenses" asp-action="RequestExpense">Expense Request</a></li>
                                        <li><a class="dropdown-item" asp-controller="Expenses" asp-action="Manage">Manage Expenses</a></li>
                                        <li><a class="dropdown-item" asp-controller="Expenses" asp-action="Report">Expense Reports</a></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Expenses" asp-action="RequestExpense">Expense Request</a>
                                </li>
                            }

                            @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
                            {
                                @* Inventory *@
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navInventoryDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Inventory
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navInventoryDropdown">
                                        <li><a class="dropdown-item" asp-controller="Products" asp-action="Index">Products</a></li>
                                        <li><a class="dropdown-item" asp-controller="ProductCategories" asp-action="Index">Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Batches" asp-action="Index">Batches</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a>
                                </li>

                                @* Cash Management *@
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navCashDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Cash Management
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navCashDropdown">
                                        <li><a class="dropdown-item" asp-controller="Cashbook" asp-action="Index">Cashbook</a></li>
                                        <li><a class="dropdown-item" asp-controller="CashReconciliation" asp-action="Index">Cash Reconciliation</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DailyClose" asp-action="Index">Daily Close</a>
                                </li>
                                @* <li class="nav-item"><a class="nav-link" asp-controller="ShiftClose" asp-action="Index">Shift Close</a></li> *@
                            }

                            @* Administration *@
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navAdminDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="navAdminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Stations" asp-action="Index">Stations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Admin</a></li>
                                        <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="HQIndex">HQ Dashboard</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        <div class="d-flex gap-2 align-items-center">
                            <span class="text-light small">@User.Identity?.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }
    else
    {
        <header class="public-header">
            <nav class="navbar navbar-expand-lg navbar-light">
                <div class="container">
                    <a class="navbar-brand public-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">M</span>
                        <span>Machar Oil &amp; Gas</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="publicNav">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Directors">Directors</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">Staff Login</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main class="@(isSignedIn ? "container-fluid py-3" : "public-main")">
        @RenderBody()
    </main>

    @if (!isSignedIn)
    {
        <footer class="public-footer">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <h4>Machar Oil and Gas Ltd</h4>
                        <p>Delivering reliable energy solutions in PMS, LPG, AGO logistics, retail and consulting.</p>
                    </div>
                    <div class="col-lg-3">
                        <h5>Quick Links</h5>
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Home" asp-action="About">About Us</a>
                        <a asp-controller="Home" asp-action="Directors">Directors</a>
                        <a asp-controller="Home" asp-action="Contact">Contact</a>
                    </div>
                    <div class="col-lg-4">
                        <h5>Staff Portal</h5>
                        <p>Authorized staff can access MacharPOS through the secure staff login.</p>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Staff Login</a>
                    </div>
                </div>
                <div class="footer-bottom">© @DateTime.Now.Year Machar Oil and Gas Ltd. All rights reserved.</div>
            </div>
        </footer>
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
