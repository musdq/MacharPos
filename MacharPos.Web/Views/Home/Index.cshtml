@{
    ViewData["Title"] = "Home";
}

<section class="public-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow">Machar Oil and Gas Ltd</span>
                <h1>Powering Nigeria's Energy Future</h1>
                <p class="lead">Trusted leaders in PMS, LPG, AGO logistics, retail, and energy consulting.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="About">Learn More</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Home" asp-action="Contact">Contact Us</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="hero-card">
                    <div class="stat-row"><span>Retail Locations</span><strong>2</strong></div>
                    <div class="stat-row"><span>Dedicated Staff</span><strong>30+</strong></div>
                    <div class="stat-row"><span>Logistics Trucks</span><strong>4</strong></div>
                    <div class="stat-row"><span>Core Focus</span><strong>LPG • PMS • AGO</strong></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">What we do</span>
            <h2>Our Core Services</h2>
            <p>We provide a comprehensive range of services to meet the energy needs of individuals, businesses, and communities across Nigeria.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">🚚</div>
                    <h3>Logistics</h3>
                    <p>Efficient transportation of PMS, LPG, and AGO nationwide using our dedicated fleet and skilled team.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">⛽</div>
                    <h3>Retail</h3>
                    <p>Reliable retail of PMS, AGO, and LPG at strategically located stations and customer-focused outlets.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">📋</div>
                    <h3>Consulting</h3>
                    <p>Expert advisory services designed to improve operations, compliance, safety, and commercial execution.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-band">
    <div class="container d-lg-flex align-items-center justify-content-between gap-4">
        <div>
            <span class="eyebrow">Partner with us</span>
            <h2>Reliable energy solutions for businesses and communities.</h2>
            <p>Join the partners who trust Machar Oil and Gas Ltd for dependable supply, retail support, and logistics.</p>
        </div>
        <a class="btn btn-light btn-lg" asp-controller="Home" asp-action="Contact">Get in Touch</a>
    </div>
</section>
