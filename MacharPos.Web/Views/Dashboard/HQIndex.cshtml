\
@model MacharPos.Web.ViewModels.HQ.HqDashboardVm
@{
    ViewData["Title"] = "HQ Dashboard";
    var dateText = Model.ReportDate.ToString("ddd, dd MMM yyyy");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h4 mb-0">HQ Dashboard</h1>
        <div class="text-secondary small">All Stations • @dateText</div>
    </div>

    <form class="d-flex gap-2" method="get" action="/hq/dashboard">
        <input type="date" class="form-control form-control-sm" name="date" value="@Model.ReportDate.ToString("yyyy-MM-dd")" />
        <button class="btn btn-dark btn-sm" type="submit">Go</button>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Total Sales</div>
                <div class="fs-4 fw-semibold">₦@Model.TotalSalesAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Cash</div>
                <div class="fs-4 fw-semibold">₦@Model.CashAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">POS</div>
                <div class="fs-4 fw-semibold">₦@Model.PosAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Transfer</div>
                <div class="fs-4 fw-semibold">₦@Model.TransferAmount.ToString("N0")</div>
            </div>
        </div>
    </div>

</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Total Cost (Known)</div>
                <div class="fs-4 fw-semibold">₦@Model.TotalCostAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Gross Profit (Known)</div>
                <div class="fs-4 fw-semibold">₦@Model.GrossProfitAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Gross Margin (Known)</div>
                <div class="fs-4 fw-semibold">@Model.GrossMarginPercent.ToString("N2")%</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">Credit</div>
                <div class="fs-4 fw-semibold">₦@Model.CreditAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">LPG Sold</div>
                <div class="fs-4 fw-semibold">@Model.LpgKgSold.ToString("N2") <span class="fs-6 text-secondary">kg</span></div>
            </div>
        </div>
    </div>
@*     <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">PMS Sold</div>
                <div class="fs-4 fw-semibold">@Model.PmsLitresSold.ToString("N2") <span class="fs-6 text-secondary">L</span></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="text-secondary small">AGO Sold</div>
                <div class="fs-4 fw-semibold">@Model.AgoLitresSold.ToString("N2") <span class="fs-6 text-secondary">L</span></div>
            </div>
        </div>
    </div> *@
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <div class="fw-semibold">Station Breakdown</div>
        <div class="text-secondary small">Sales + payment split + volume KPIs</div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Station</th>
                        <th class="text-end">Sales (₦)</th>
                        <th class="text-end">Cash (₦)</th>
                        <th class="text-end">POS (₦)</th>
                        <th class="text-end">Transfer (₦)</th>
                        <th class="text-end">Credit (₦)</th>
                        <th class="text-end">Cost (₦)</th>
                        <th class="text-end">Gross Profit (₦)</th>
                        <th class="text-end">Margin (%)</th>
                        <th class="text-end">LPG (kg)</th>
@*                         <th class="text-end">PMS (L)</th>
                        <th class="text-end">AGO (L)</th> *@
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model.Stations)
                {
                    <tr>
                        <td>@s.StationName</td>
                        <td class="text-end">₦@s.SalesAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.CashAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.PosAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.TransferAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.CreditAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.CostAmount.ToString("N0")</td>
                        <td class="text-end">₦@s.GrossProfitAmount.ToString("N0")</td>
                        <td class="text-end">@s.GrossMarginPercent.ToString("N2")%</td>
                        <td class="text-end">@s.LpgKgSold.ToString("N2")</td>
@*                         <td class="text-end">@s.PmsLitresSold.ToString("N2")</td>
                        <td class="text-end">@s.AgoLitresSold.ToString("N2")</td> *@
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Alerts.Any())
{
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="fw-semibold">Alerts</div>
            <div class="text-secondary small">Low stock and operational warnings</div>
        </div>
        <div class="card-body">
            <ul class="mb-0">
                @foreach (var a in Model.Alerts)
                {
                    <li>@a</li>
                }
            </ul>
        </div>
    </div>
}
