@model MacharPos.Web.ViewModels.Sales.SaleCreateVm
@using MacharPos.Core.Entities
@using MacharPos.Web.ViewModels.Sales

@{
    ViewData["Title"] = "New Sale";
    var productPrices = ViewBag.ProductPrices as Dictionary<string, decimal>
                      ?? new Dictionary<string, decimal>();

    var productEquivalentKgs = ViewBag.ProductEquivalentKgs as Dictionary<string, decimal>
                            ?? new Dictionary<string, decimal>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" />

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h5 mb-0">New Sale</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

@if (ViewBag.UnclosedDate is string unclosed && ViewBag.UnclosedDateDisplay is string unclosedDisplay)
{
    <div class="alert alert-warning d-flex align-items-start justify-content-between gap-3">
        <div>
            <div class="fw-semibold">Previous day not closed</div>
            <div class="small text-muted">Please close <span class="fw-semibold">@unclosedDisplay</span> to keep reconciliation accurate.</div>
        </div>
        <a class="btn btn-sm btn-outline-dark" href="/DailyClose?date=@unclosed">Go to Daily Close</a>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@e.ErrorMessage</div>
        }
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post" id="saleForm">
            @Html.AntiForgeryToken()

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <div class="d-flex align-items-center justify-content-between">
                        <label class="form-label mb-1">Customer</label>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#quickCustomerModal">
                            + New Customer
                        </button>
                    </div>

                    <select class="form-select" asp-for="CustomerId" asp-items="Model.Customers" id="CustomerId"></select>
                    <div class="form-text">Search by customer name or phone number. Default is Walk-in.</div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label">Payment Method</label>
                    <select class="form-select" asp-for="PaymentMethod" asp-items="Model.PaymentMethods"></select>
                </div>
            </div>

            <div class="border rounded p-3 mt-3 bg-light-subtle">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="fw-semibold">Loyalty Program</div>
                        <div class="small text-muted">Buy 6 refills, get 25% off the 7th refill.</div>
                    </div>
                    <div class="text-end small">
                        <div>Stamps: <span class="fw-semibold" id="loyaltyStampCount">@Model.LoyaltyStampCount</span> / 6</div>
                        <div>Rewards: <span class="fw-semibold" id="loyaltyRewardCount">@Model.LoyaltyAvailableRewards</span></div>
                    </div>
                </div>

                <div id="loyaltyMessage"
                     class="mt-2 small @(Model.LoyaltyEligibleCustomer ? "text-success" : "text-muted")">
                    @(Model.LoyaltyMessage ?? "Select a named customer to use loyalty.")
                </div>

                <div id="loyaltyRewardWrap" class="mt-2 @(Model.CustomerId.HasValue && Model.LoyaltyAvailableRewards > 0 ? "" : "d-none")">
                    <div class="form-check">
                        <input asp-for="ApplyLoyaltyReward" class="form-check-input" id="ApplyLoyaltyReward" />
                        <label asp-for="ApplyLoyaltyReward" class="form-check-label">
                            Apply loyalty reward (25% off next refill)
                        </label>
                    </div>
                </div>

                <div id="loyaltyRewardHiddenWrap" class="@((Model.CustomerId.HasValue && Model.LoyaltyAvailableRewards > 0) ? "d-none" : "")">
                    <input type="hidden" asp-for="ApplyLoyaltyReward" id="ApplyLoyaltyRewardHidden" value="false" />
                </div>

                <div id="loyaltyPreviewWrap" class="small text-success mt-2 @(Model.LoyaltyPreviewDiscount > 0 ? "" : "d-none")">
                    Loyalty discount preview: ₦<span id="loyaltyPreviewAmount">@Model.LoyaltyPreviewDiscount.ToString("N2")</span>
                </div>
            </div>

            <hr class="my-3" />

            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <label class="form-label">Manual Discount (₦)</label>
                    <input class="form-control" asp-for="DiscountAmount" type="number" step="0.01" value="@Model.DiscountAmount" oninput="toggleManagerAuth()" />
                </div>

                <div class="col-12 col-md-4" id="mgrEmailWrap" style="display:none;">
                    <label class="form-label">Manager Email</label>
                    <input class="form-control" asp-for="ManagerEmail" type="email" />
                </div>

                <div class="col-12 col-md-4" id="mgrPassWrap" style="display:none;">
                    <label class="form-label">Manager Password</label>
                    <input class="form-control" asp-for="ManagerPassword" type="password" />
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex align-items-center justify-content-between">
                <div class="fw-semibold">Items</div>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="addLine()">Add Line</button>
            </div>

            <div class="table-responsive mt-2">
                <table class="table table-sm align-middle" id="linesTable">
                    <thead>
                        <tr>
                            <th style="min-width:260px;">Product</th>
                            <th style="width:140px;">Mode</th>
                            <th style="width:110px;">Qty (Cyl)</th>
                            <th style="width:110px;">Kg</th>
                            <th style="width:140px;">Amount (₦)</th>
                            <th style="width:140px;">Unit Price</th>
                            <th class="text-end" style="width:160px;">Line Total</th>
                            <th style="width:50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select class="form-select product-select" name="Lines[@i].ProductId" onchange="onProductChange(this)">
                                        <option value="">Select...</option>
                                        @foreach (var p in Model.Products)
                                        {
                                            var price = productPrices.TryGetValue(p.Value, out var pv) ? pv : 0m;
                                            var eqKg = productEquivalentKgs.TryGetValue(p.Value, out var ev) ? ev : 0m;
                                            var selected = Model.Lines[i].ProductId != Guid.Empty && Model.Lines[i].ProductId.ToString() == p.Value;

                                            if (selected)
                                            {
                                                <option value="@p.Value" data-price="@price" data-eqkg="@eqKg" selected>@p.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@p.Value" data-price="@price" data-eqkg="@eqKg">@p.Text</option>
                                            }
                                        }
                                    </select>
                                </td>

                                <td>
                                    <select class="form-select mode-select" name="Lines[@i].EntryMode" onchange="onModeChange(this)">
                                        @if (Model.Lines[i].EntryMode == SaleEntryMode.ByQty)
                                        {
                                            <option value="1" selected>By Kg</option>
                                            <option value="2">By Amount</option>
                                        }
                                        else
                                        {
                                            <option value="1">By Kg</option>
                                            <option value="2" selected>By Amount</option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input class="form-control qty-input" name="Lines[@i].Qty" type="number" step="1" min="1" value="@(Model.Lines[i].Qty <= 0 ? 1 : Model.Lines[i].Qty)" oninput="calcTotals()" />
                                </td>

                                <td>
                                    <input class="form-control kg-input" name="Lines[@i].Kg" type="number" step="0.01" value="@(Model.Lines[i].Kg?.ToString("0.##") ?? "")" readonly />
                                </td>

                                <td>
                                    <input class="form-control amount-input" name="Lines[@i].Amount" type="number" step="0.01" value="@(Model.Lines[i].Amount?.ToString("0.##") ?? "")" oninput="calcTotals()" />
                                </td>

                                <td>
                                    <input class="form-control price-input" name="Lines[@i].UnitPrice" type="number" step="0.01" value="@Model.Lines[i].UnitPrice" readonly oninput="calcTotals()" />
                                    <div class="form-text mt-1">
                                        <a href="#" class="text-decoration-none" onclick="return togglePriceOverride(this)">Override</a>
                                    </div>
                                </td>

                                <td class="text-end">
                                    <span class="lineTotal">0.00</span>
                                </td>

                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLine(this)">×</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end mt-2">
                <div class="fs-6">
                    Total: <span class="fw-semibold">₦<span id="grandTotal">0.00</span></span>
                </div>
            </div>

            <button type="submit" class="btn btn-dark w-100 mt-3" id="completeSaleBtn">
                <span class="btn-text">Complete Sale</span>
            </button>
        </form>
    </div>

    <div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-labelledby="quickCustomerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="quickCustomerForm">
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <h5 class="modal-title" id="quickCustomerModalLabel">Add New Customer</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div id="quickCustomerError" class="alert alert-danger d-none"></div>
                        <div id="quickCustomerSuccess" class="alert alert-success d-none"></div>

                        <div class="mb-3">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="Name" id="QuickCustomerName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" name="Phone" id="QuickCustomerPhone" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" name="Address" id="QuickCustomerAddress" rows="2"></textarea>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsLoyaltyEnabled" id="QuickCustomerLoyaltyEnabled" checked />
                            <label class="form-check-label" for="QuickCustomerLoyaltyEnabled">
                                Enable loyalty for this customer
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark" id="quickCustomerSaveBtn">
                            <span class="btn-text">Save Customer</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script>
        const BY_AMOUNT_ALLOWED_PRODUCTS = [
          "LPG Refill – 1kg",
          "Dealer lpg refill 1kg"
        ];

        let ALL_PRODUCT_OPTIONS = [];


        function addLine() {
          const tbody = document.querySelector("#linesTable tbody");
          const idx = tbody.querySelectorAll("tr").length;

          const row = document.createElement("tr");
          row.innerHTML = `
            <td>
              <select class="form-select product-select" name="Lines[${idx}].ProductId" onchange="onProductChange(this)">
                <option value="">Select...</option>
                ${getProductsOptionsHtml()}
              </select>
            </td>
            <td>
              <select class="form-select mode-select" name="Lines[${idx}].EntryMode" onchange="onModeChange(this)">
                <option value="1" selected>By Kg</option>
                <option value="2">By Amount</option>
              </select>
            </td>
            <td>
              <input class="form-control qty-input" name="Lines[${idx}].Qty" type="number" step="1" min="1" value="1" oninput="calcTotals()" />
            </td>
            <td>
              <input class="form-control kg-input" name="Lines[${idx}].Kg" type="number" step="0.01" value="" readonly />
            </td>
            <td>
              <input class="form-control amount-input" name="Lines[${idx}].Amount" type="number" step="0.01" value="" oninput="calcTotals()" />
            </td>
            <td>
              <input class="form-control price-input" name="Lines[${idx}].UnitPrice" type="number" step="0.01" value="0" readonly oninput="calcTotals()" />
              <div class="form-text mt-1">
                <a href="#" class="text-decoration-none" onclick="return togglePriceOverride(this)">Override</a>
              </div>
            </td>
            <td class="text-end"><span class="lineTotal">0.00</span></td>
            <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm" onclick="removeLine(this)">×</button></td>
          `;
          tbody.appendChild(row);
          enhanceRow(row);
          setRowModeState(row);
          calcTotals();
          focusProductOnRow(row);
        }

        function removeLine(btn) {
          const tbody = document.querySelector("#linesTable tbody");
          const row = btn.closest("tr");
          row.remove();

          const rows = tbody.querySelectorAll("tr");
          rows.forEach((r, idx) => {
            r.querySelectorAll("select, input").forEach(el => {
              if (el.name) el.name = el.name.replace(/Lines\[\d+\]/, `Lines[${idx}]`);
            });
          });

          calcTotals();
          toggleManagerAuth();
        }

        function calcTotals() {
          const rows = document.querySelectorAll("#linesTable tbody tr");
          let grand = 0;

          rows.forEach(r => {
            const mode = r.querySelector('select[name$=".EntryMode"]').value;
            const productSelect = r.querySelector('select[name$=".ProductId"]');
            const selectedOpt = productSelect?.options[productSelect.selectedIndex];

            const eqKg = parseFloat(selectedOpt?.getAttribute("data-eqkg") || "0");
            const qtyInput = r.querySelector('input[name$=".Qty"]');
            const kgInput = r.querySelector('input[name$=".Kg"]');
            const amountInput = r.querySelector('input[name$=".Amount"]');
            const priceInput = r.querySelector('input[name$=".UnitPrice"]');

            const qty = parseFloat(qtyInput.value || "0");
            const amount = parseFloat(amountInput.value || "0");
            const price = parseFloat(priceInput.value || "0");

            let total = 0;

            if (mode === "2") {
              total = amount || 0;

              if (price > 0 && amount > 0) {
                kgInput.value = (amount / price).toFixed(2);
              } else {
                kgInput.value = "";
              }

              if (!qtyInput.value || parseFloat(qtyInput.value) <= 0) {
                qtyInput.value = "1";
              }
            } else {
              if (eqKg > 0 && qty > 0) {
                kgInput.value = (qty * eqKg).toFixed(2);
              } else {
                kgInput.value = "";
              }

              total = (qty * price) || 0;

              if (qty > 0 && price > 0) {
                amountInput.value = total.toFixed(2);
              } else {
                amountInput.value = "";
              }

              if (!qtyInput.value || parseFloat(qtyInput.value) <= 0) {
                qtyInput.value = "1";
              }
            }

            r.querySelector(".lineTotal").innerText = total.toFixed(2);
            grand += total;
          });

          document.getElementById("grandTotal").innerText = grand.toFixed(2);
        }

        function onProductChange(sel) {
          const opt = sel.options[sel.selectedIndex];
          const price = parseFloat(opt.getAttribute("data-price") || "0");
          const eqKg = parseFloat(opt.getAttribute("data-eqkg") || "0");
          const row = sel.closest("tr");

          row.querySelector('input[name$=".UnitPrice"]').value = price.toFixed(2);

          const mode = row.querySelector('select[name$=".EntryMode"]').value;
          const qtyInput = row.querySelector('input[name$=".Qty"]');
          const kgInput = row.querySelector('input[name$=".Kg"]');
          const qty = parseFloat(qtyInput.value || "0");

          if (mode === "1" && eqKg > 0 && qty > 0) {
            kgInput.value = (qty * eqKg).toFixed(2);
          } else if (mode === "2") {
            kgInput.value = "";
          }

          calcTotals();
          toggleManagerAuth();
          focusPrimaryInputOnRow(row);
        }

        function onModeChange(sel) {
          const row = sel.closest("tr");
          setRowModeState(row);
          calcTotals();
          focusPrimaryInputOnRow(row);
        }

        function setRowModeState(row) {
          const mode = row.querySelector('select[name$=".EntryMode"]').value;
          const kgInput = row.querySelector('input[name$=".Kg"]');
          const amountInput = row.querySelector('input[name$=".Amount"]');
          const qtyInput = row.querySelector('input[name$=".Qty"]');

          if (mode === "2") {
            kgInput.setAttribute("readonly", "readonly");
            amountInput.removeAttribute("readonly");

            // By Amount should always be one LPG base product line
            if (qtyInput) qtyInput.value = "1";
          } else {
            kgInput.setAttribute("readonly", "readonly");
            amountInput.setAttribute("readonly", "readonly");
          }

          filterProductsForMode(row);
        }


        function togglePriceOverride(anchor) {
          const row = anchor.closest("tr");
          const priceInput = row.querySelector('input[name$=".UnitPrice"]');
          const isReadonly = priceInput.hasAttribute("readonly");

          if (isReadonly) {
            priceInput.removeAttribute("readonly");
            anchor.textContent = "Lock Price";
            priceInput.focus();
          } else {
            priceInput.setAttribute("readonly", "readonly");
            anchor.textContent = "Override";
          }

          toggleManagerAuth();
          calcTotals();
          return false;
        }

        function toggleManagerAuth() {
          const discount = parseFloat(document.querySelector('[name="DiscountAmount"]').value || "0");
          let hasOverride = false;

          document.querySelectorAll("#linesTable tbody tr").forEach(r => {
            const productSelect = r.querySelector('select[name$=".ProductId"]');
            const selectedOpt = productSelect?.options[productSelect.selectedIndex];
            const defaultPrice = parseFloat(selectedOpt?.getAttribute("data-price") || "0");
            const actualPrice = parseFloat(r.querySelector('input[name$=".UnitPrice"]').value || "0");

            if (actualPrice > 0 && defaultPrice > 0 && Math.abs(actualPrice - defaultPrice) > 0.0001) {
              hasOverride = true;
            }
          });

          const show = discount > 0 || hasOverride;
          document.getElementById("mgrEmailWrap").style.display = show ? "" : "none";
          document.getElementById("mgrPassWrap").style.display = show ? "" : "none";
        }

        let ALL_PRODUCT_OPTIONS = [];

        function captureAllProductOptions() {
          const first = document.querySelector(".product-select");
          if (!first) return;

          ALL_PRODUCT_OPTIONS = Array.from(first.options)
            .filter(o => o.value)
            .map(o => ({
              value: o.value,
              text: o.text.trim(),
              price: o.getAttribute("data-price") || "0",
              eqkg: o.getAttribute("data-eqkg") || "0"
            }));
        }

        function getProductsOptionsHtml() {
          return ALL_PRODUCT_OPTIONS.map(o =>
            `<option value="${o.value}" data-price="${o.price}" data-eqkg="${o.eqkg}">
              ${o.text}
            </option>`
          ).join("");
        }

        function enhanceRow(row) {
          const select = row.querySelector(".product-select");
          if (select) {
            new TomSelect(select, {
              create: false,
              allowEmptyOption: true,
              placeholder: "Select product..."
            });
          }
        }

        function focusProductOnRow(row) {
          const ts = row.querySelector(".product-select")?.tomselect;
          if (ts) ts.focus();
        }

        function focusPrimaryInputOnRow(row) {
          const mode = row.querySelector('select[name$=".EntryMode"]').value;
          const target = mode === "2"
            ? row.querySelector('input[name$=".Amount"]')
            : row.querySelector('input[name$=".Qty"]');

          target?.focus();
          target?.select?.();
        }

        async function refreshCustomerLoyalty() {
          const customerSelect = document.getElementById("CustomerId");
          if (!customerSelect) return;

          const customerId = customerSelect.value;

          const stampEl = document.getElementById("loyaltyStampCount");
          const rewardEl = document.getElementById("loyaltyRewardCount");
          const messageEl = document.getElementById("loyaltyMessage");
          const rewardWrap = document.getElementById("loyaltyRewardWrap");
          const previewWrap = document.getElementById("loyaltyPreviewWrap");
          const previewAmount = document.getElementById("loyaltyPreviewAmount");
          const applyRewardCheckbox = document.getElementById("ApplyLoyaltyReward");

          if (!customerId) {
            if (stampEl) stampEl.textContent = "0";
            if (rewardEl) rewardEl.textContent = "0";

            if (messageEl) {
              messageEl.textContent = "Select a named customer to use loyalty.";
              messageEl.classList.remove("text-success");
              messageEl.classList.add("text-muted");
            }

            if (rewardWrap) rewardWrap.classList.add("d-none");
            if (previewWrap) previewWrap.classList.add("d-none");
            if (applyRewardCheckbox) applyRewardCheckbox.checked = false;
            return;
          }

          try {
            const response = await fetch(`/Sales/GetCustomerLoyalty?customerId=${encodeURIComponent(customerId)}`, {
              headers: {
                "X-Requested-With": "XMLHttpRequest"
              }
            });

            if (!response.ok) {
              throw new Error("Failed to load loyalty info.");
            }

            const data = await response.json();

            if (stampEl) stampEl.textContent = data.loyaltyStampCount ?? 0;
            if (rewardEl) rewardEl.textContent = data.loyaltyAvailableRewards ?? 0;

            if (messageEl) {
              messageEl.textContent = data.loyaltyMessage || "Select a named customer to use loyalty.";
              messageEl.classList.remove("text-success", "text-muted");
              messageEl.classList.add(data.loyaltyEligibleCustomer ? "text-success" : "text-muted");
            }

            const canRedeem = !!data.canRedeem;

            if (rewardWrap) {
              rewardWrap.classList.toggle("d-none", !canRedeem);
            }

            if (!canRedeem && applyRewardCheckbox) {
              applyRewardCheckbox.checked = false;
            }

            if (previewWrap) {
              const discount = Number(data.loyaltyPreviewDiscount || 0);
              if (discount > 0) {
                previewWrap.classList.remove("d-none");
                if (previewAmount) {
                  previewAmount.textContent = discount.toLocaleString(undefined, {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                  });
                }
              } else {
                previewWrap.classList.add("d-none");
              }
            }
          } catch (err) {
            console.error(err);
          }
        }

        function wireCustomerLoyaltyRefresh() {
          const customerSelect = document.getElementById("CustomerId");
          if (!customerSelect) return;

          customerSelect.addEventListener("change", function () {
            refreshCustomerLoyalty();
          });
        }

        function initCustomerSelect() {
          const customerSelect = document.getElementById("CustomerId");
          if (!customerSelect) return;

          if (customerSelect.tomselect) {
            customerSelect.tomselect.destroy();
          }

          new TomSelect(customerSelect, {
            create: false,
            allowEmptyOption: true,
            placeholder: "Search customer by name or phone...",
            maxOptions: 200,
            onChange: function () {
              refreshCustomerLoyalty();
            }
          });
        }

        function filterProductsForMode(row) {
          const mode = row.querySelector('select[name$=".EntryMode"]').value;
          const selectEl = row.querySelector('.product-select');
          if (!selectEl) return;

          const currentValue = selectEl.value || "";

          let filteredOptions = [];

          if (mode === "2") {
            filteredOptions = ALL_PRODUCT_OPTIONS.filter(o =>
              BY_AMOUNT_ALLOWED_PRODUCTS.includes(o.text)
            );
          } else {
            filteredOptions = [...ALL_PRODUCT_OPTIONS];
          }

          if (selectEl.tomselect) {
            selectEl.tomselect.destroy();
          }

          selectEl.innerHTML = '<option value="">Select...</option>' +
            filteredOptions.map(o =>
              `<option value="${o.value}" data-price="${o.price}" data-eqkg="${o.eqkg}">${o.text}</option>`
            ).join("");

          const stillExists = filteredOptions.some(o => o.value === currentValue);

          if (stillExists) {
            selectEl.value = currentValue;
          } else if (mode === "2") {
            const preferred =
              filteredOptions.find(o => o.text === "LPG Refill – 1kg") ||
              filteredOptions[0];

            if (preferred) {
              selectEl.value = preferred.value;
            }
          } else {
            selectEl.value = "";
          }

          new TomSelect(selectEl, {
            create: false,
            allowEmptyOption: true,
            placeholder: "Select product..."
          });

          onProductChange(selectEl);
        }

        document.addEventListener("DOMContentLoaded", function () {
            initCustomerSelect();
            captureAllProductOptions();
         const quickCustomerForm = document.getElementById("quickCustomerForm");
        if (quickCustomerForm) {
          quickCustomerForm.addEventListener("submit", submitQuickCustomerForm);
        }

        const quickCustomerModal = document.getElementById("quickCustomerModal");
        if (quickCustomerModal) {
          quickCustomerModal.addEventListener("shown.bs.modal", function () {
            document.getElementById("QuickCustomerName")?.focus();
          });

          quickCustomerModal.addEventListener("hidden.bs.modal", function () {
            resetQuickCustomerForm();
          });
        }

          document.querySelectorAll(".product-select").forEach(s => {
            new TomSelect(s, {
              create: false,
              allowEmptyOption: true,
              placeholder: "Select product..."
            });
          });

          document.querySelectorAll("#linesTable tbody tr").forEach(r => setRowModeState(r));
          calcTotals();
          toggleManagerAuth();
          wireCustomerLoyaltyRefresh();
          refreshCustomerLoyalty();

          document.getElementById("saleForm").addEventListener("submit", function () {
            const btn = document.getElementById("completeSaleBtn");
            btn.disabled = true;
            btn.querySelector(".btn-text").innerText = "Processing...";
          });
        });
    </script>
    <script>
        function getAntiForgeryToken() {
          const tokenInput = document.querySelector('#quickCustomerForm input[name="__RequestVerificationToken"]')
            || document.querySelector('#saleForm input[name="__RequestVerificationToken"]');
          return tokenInput ? tokenInput.value : "";
        }

        function resetQuickCustomerForm() {
          const form = document.getElementById("quickCustomerForm");
          if (form) form.reset();

          const errorEl = document.getElementById("quickCustomerError");
          const successEl = document.getElementById("quickCustomerSuccess");

          if (errorEl) {
            errorEl.classList.add("d-none");
            errorEl.textContent = "";
          }

          if (successEl) {
            successEl.classList.add("d-none");
            successEl.textContent = "";
          }

          const loyaltyCheckbox = document.getElementById("QuickCustomerLoyaltyEnabled");
          if (loyaltyCheckbox) loyaltyCheckbox.checked = true;
        }

        function showQuickCustomerError(message) {
          const errorEl = document.getElementById("quickCustomerError");
          const successEl = document.getElementById("quickCustomerSuccess");

          if (successEl) {
            successEl.classList.add("d-none");
            successEl.textContent = "";
          }

          if (errorEl) {
            errorEl.textContent = message || "Unable to save customer.";
            errorEl.classList.remove("d-none");
          }
        }

        function addCustomerToSelectAndChoose(customer) {
          const customerSelect = document.getElementById("CustomerId");
          if (!customerSelect) return;

          const text = customer.phone
            ? `${customer.name} (${customer.phone})`
            : customer.name;

          if (customerSelect.tomselect) {
            const ts = customerSelect.tomselect;

            if (!ts.options[customer.id]) {
              ts.addOption({
                value: customer.id,
                text: text
              });
            }

            ts.setValue(customer.id);
            ts.refreshOptions(false);
          } else {
            let existing = Array.from(customerSelect.options).find(o => o.value === customer.id);

            if (!existing) {
              const opt = document.createElement("option");
              opt.value = customer.id;
              opt.text = text;
              customerSelect.appendChild(opt);
            }

            customerSelect.value = customer.id;
          }

          refreshCustomerLoyalty();
        }

        async function submitQuickCustomerForm(e) {
          e.preventDefault();

          const form = document.getElementById("quickCustomerForm");
          const saveBtn = document.getElementById("quickCustomerSaveBtn");
          const btnText = saveBtn?.querySelector(".btn-text");

          const errorEl = document.getElementById("quickCustomerError");
          const successEl = document.getElementById("quickCustomerSuccess");

          if (errorEl) {
            errorEl.classList.add("d-none");
            errorEl.textContent = "";
          }

          if (successEl) {
            successEl.classList.add("d-none");
            successEl.textContent = "";
          }

          const formData = new FormData(form);

          if (!formData.get("IsLoyaltyEnabled")) {
            formData.set("IsLoyaltyEnabled", "false");
          }

          saveBtn.disabled = true;
          if (btnText) btnText.textContent = "Saving...";

          try {
            const response = await fetch('/Customers/QuickCreate', {
              method: 'POST',
              headers: {
                'RequestVerificationToken': getAntiForgeryToken(),
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: formData
            });

            const data = await response.json();

                if (!response.ok || !data.ok) {
          if (data.existingCustomerId) {
            addCustomerToSelectAndChoose({
              id: data.existingCustomerId,
              name: data.existingCustomerName,
              phone: formData.get("Phone") || ""
            });

            const modalEl = document.getElementById("quickCustomerModal");
            const modal = bootstrap.Modal.getInstance(modalEl);
            modal?.hide();

            resetQuickCustomerForm();
            return;
          }

          showQuickCustomerError(data.message || "Unable to save customer.");
          return;
        }

            addCustomerToSelectAndChoose(data);

            if (successEl) {
              successEl.textContent = "Customer added successfully.";
              successEl.classList.remove("d-none");
            }

            setTimeout(() => {
              const modalEl = document.getElementById("quickCustomerModal");
              const modal = bootstrap.Modal.getInstance(modalEl);
              modal?.hide();
              resetQuickCustomerForm();
            }, 500);
          } catch (err) {
            console.error(err);
            showQuickCustomerError("Something went wrong while saving the customer.");
          } finally {
            saveBtn.disabled = false;
            if (btnText) btnText.textContent = "Save Customer";
          }
        }
    </script>
}
