@model List<MacharPos.Core.Entities.Product>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Products";
    var categories = (SelectList)ViewBag.Categories;
    Guid? categoryId = (Guid?)ViewBag.CategoryId;
    bool showInactive = (bool)ViewBag.ShowInactive;
}
<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h5 mb-0">Products</h1>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-controller="ProductCategories" asp-action="Index">Categories</a>
    <a class="btn btn-dark btn-sm" asp-action="Create">Add Product</a>
  </div>
</div>
@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
<div class="card shadow-sm">
  <div class="card-body">
        <form asp-action="BulkUpdatePrices" method="post" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()

            <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
            <input type="hidden" name="showInactive" value="@ViewBag.ShowInactive" />

            <div class="col-auto">
                <label for="pricePerKg" class="form-label">LPG Price per Kg</label>
                <input type="number" step="0.01" min="0" name="pricePerKg" id="pricePerKg" class="form-control" placeholder="e.g. 1035" required />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-danger">
                    Update All Product Prices
                </button>
            </div>
        </form>
    <form class="row g-2 align-items-end" method="get">
      <div class="col-12 col-md-5">
        <label class="form-label">Category</label>
        <select class="form-select" name="categoryId" asp-items="categories">
          <option value="">All</option>
        </select>
      </div>
      <div class="col-12 col-md-4">
        <div class="form-check mt-4">
          <input class="form-check-input" type="checkbox" name="showInactive" value="true" @(showInactive ? "checked" : "") />
          <label class="form-check-label">Show inactive</label>
        </div>
      </div>
      <div class="col-12 col-md-3">
        <button class="btn btn-outline-primary w-100">Filter</button>
      </div>
    </form>
    <div class="table-responsive mt-3">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Category</th>
            <th>Name</th>
            <th class="text-end">Default Price</th>
            <th class="text-end">Kg (if LPG)</th>
            <th>Status</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var p in Model)
          {
            <tr>
              <td>@p.Category?.Name</td>
              <td class="text-break">@p.Name</td>
              <td class="text-end">@p.DefaultUnitPrice.ToString("N2")</td>
              <td class="text-end">@((p.EquivalentKg ?? 0m) == 0m ? "-" : p.EquivalentKg!.Value.ToString("N2"))</td>
              <td>
                @if (p.IsActive) { <span class="badge text-bg-success">Active</span> }
                else { <span class="badge text-bg-secondary">Inactive</span> }
              </td>
              <td class="text-end">
                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>