@model MacharPos.Core.Entities.Sale
@{
    ViewData["Title"] = "Receipt";
}


<div class="no-print d-flex align-items-center justify-content-between mb-3">
@*   <div>
    <h1 class="h5 mb-0">Receipt</h1>
    <div class="text-secondary small">@Model.ReceiptNo</div>
  </div> *@
  <div class="d-flex gap-2">
    <button class="btn btn-primary btn-sm" type="button" onclick="printThermal()">Print</button>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to Sales</a>
  </div>
</div>

<div class="receipt card shadow-sm mx-auto">
  <div class="card-body p-3">
    <div class="text-center fw-semibold">@Model.Station?.Name</div>
    <div class="text-center small text-secondary">Machar POS Receipt</div>
    @if (Model.Status == MacharPos.Core.Entities.SaleStatus.Voided)
    {
      <div class="text-center mt-2">
        <span class="badge text-bg-danger">VOID</span>
      </div>
    }
    <hr />

    <div class="small">
      <div><span class="text-secondary">Receipt:</span> <span class="fw-semibold">@Model.ReceiptNo</span></div>
      <div><span class="text-secondary">Date:</span> @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
      <div><span class="text-secondary">Customer:</span> @(Model.Customer?.Name ?? "Walk-in")</div>
      <div><span class="text-secondary">Payment:</span> @Model.PaymentMethod</div>
    </div>

    <hr />

    <table class="table table-sm mb-0">
      <thead>
        <tr>
          <th class="small">Item</th>
          <th class="small text-end">Total</th>
        </tr>
      </thead>
      <tbody>
      @foreach (var it in Model.Items)
{
  var isLpg = (it.LpgKg ?? 0m) > 0m;

  <tr>
    <td class="small">
      <div class="fw-semibold">@it.Product?.Name</div>

      @if (isLpg)
      {
        <div class="text-secondary">
@*           @it.Qty.ToString("N0") cyl *@
          @if (it.LpgKg.HasValue)
          {
            <span>@it.LpgKg.Value.ToString("N2") kg</span>
          }
          <span>| ₦@it.UnitPrice.ToString("N2")</span>
        </div>
      }
      else
      {
        <div class="text-secondary">@it.Qty.ToString("N2") x ₦@it.UnitPrice.ToString("N2")</div>
      }
    </td>
    <td class="small text-end">₦@it.LineTotal.ToString("N2")</td>
  </tr>
}
      </tbody>
    </table>

        <hr />
        <div class="d-flex justify-content-between">
            <div class="fw-semibold">Subtotal</div>
            <div class="fw-semibold">₦@Model.Subtotal.ToString("N2")</div>
        </div>

        @if (Model.LoyaltyDiscountAmount > 0)
        {
            <div class="d-flex justify-content-between">
                <div class="fw-semibold">Loyalty Discount</div>
                <div class="fw-semibold">- ₦@Model.LoyaltyDiscountAmount.ToString("N2")</div>
            </div>
        }

        @if (Model.DiscountAmount > Model.LoyaltyDiscountAmount)
        {
            <div class="d-flex justify-content-between">
                <div class="fw-semibold">Manual Discount</div>
                <div class="fw-semibold">- ₦@((Model.DiscountAmount - Model.LoyaltyDiscountAmount).ToString("N2"))</div>
            </div>
        }

        @if (Model.LoyaltyRewardApplied)
        {
            <div class="small text-success mt-2">
                Loyalty reward applied: 25% off one qualifying refill.
            </div>
        }

        <div class="d-flex justify-content-between fw-semibold mt-1">
            <div>Total</div>
            <div>₦@Model.Total.ToString("N2")</div>
        </div>


    <div class="text-center small text-secondary mt-2">Thank you!</div>
  </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/qz-tray/qz-tray.js"></script>

<script>
    qz.security.setCertificatePromise(async function() {
        const response = await fetch("/qz/digital-certificate.txt", {
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error(`Certificate request failed: ${response.status}`);
        }

        return await response.text();
    });

    qz.security.setSignatureAlgorithm("SHA512");

    qz.security.setSignaturePromise(async function(toSign) {
        const response = await fetch("/qz/sign", {
            method: "POST",
            headers: {
                "Content-Type": "text/plain;charset=UTF-8"
            },
            body: toSign
        });

        if (!response.ok) {
            throw new Error(`QZ signing failed: ${response.status}`);
        }

        return await response.text();
    });
</script>

<script>
  // Change this to the EXACT printer name you see in Windows (Devices & Printers)
  const THERMAL_PRINTER_NAME = "XP-80C";

 function escInit() { return '\x1B\x40'; }
  function escAlign(n) { return '\x1B\x61' + String.fromCharCode(n); }
  function escBold(on) { return '\x1B\x45' + (on ? '\x01' : '\x00'); }
  function escLF(lines = 1) { return '\n'.repeat(lines); }

  const cutPartial = "\x1D\x56\x01";
  const feed5 = "\x1B\x64\x05";

  const LINE_WIDTH = 42;
  function padRight(s, w) { s = (s ?? "").toString(); return s.length >= w ? s.slice(0, w) : s + " ".repeat(w - s.length); }
  function padLeft(s, w) { s = (s ?? "").toString(); return s.length >= w ? s.slice(0, w) : " ".repeat(w - s.length) + s; }
  function money(n){ return "₦" + (Number(n)||0).toLocaleString(undefined,{minimumFractionDigits:2, maximumFractionDigits:2}); }
  function hr(){ return "-".repeat(LINE_WIDTH) + "\n"; }

  function buildReceiptText(sale){
    let out = "";
    out += escInit();
    out += escAlign(1);
    out += escBold(true) + (sale.stationName || "Machar Station") + "\n" + escBold(false);
    out += "Machar POS Receipt\n";
    if (sale.status === "Voided") out += "*** VOID ***\n";
    out += escAlign(0);
    out += hr();

    out += `Receipt: ${sale.receiptNo}\n`;
    out += `Date:    ${sale.createdAtLocal}\n`;
    out += `Customer:${sale.customerName}\n`;
    out += `Payment: ${sale.paymentMethod}\n`;
    out += hr();

    // Items
  for (const it of sale.items){
  const name = it.name || "Item";
  const total = money(it.lineTotal);
  out += padRight(name, LINE_WIDTH - total.length) + total + "\n";

  if ((Number(it.lpgKg) || 0) > 0) {
    out += `  ${Number(it.qty).toFixed(0)} cyl | ${Number(it.lpgKg).toFixed(2)} kg | ${money(it.unitPrice)}\n`;
  } else {
    out += `  ${Number(it.qty).toFixed(2)} x ${money(it.unitPrice)}\n`;
  }
}

    out += hr();
    out += padRight("Subtotal", LINE_WIDTH - money(sale.subtotal).length) + money(sale.subtotal) + "\n";
    if (sale.loyaltyDiscountAmount > 0){
      const disc = "- " + money(sale.loyaltyDiscountAmount);
      out += padRight("Loyalty", LINE_WIDTH - disc.length) + disc + "\n";
    }
    const manualDiscount = (sale.discountAmount || 0) - (sale.loyaltyDiscountAmount || 0);
    if (manualDiscount > 0){
      const disc = "- " + money(manualDiscount);
      out += padRight("Discount", LINE_WIDTH - disc.length) + disc + "\n";
    }
    out += padRight("TOTAL", LINE_WIDTH - money(sale.total).length) + money(sale.total) + "\n";
 out += escAlign(1);
    out += escLF(1);
    out += "Thank you!\n";
    out += escLF(3);

    out += feed5;
    out += cutPartial;
    return out;
  }

  function money(n){ 
  return "NGN " + (Number(n)||0).toLocaleString(undefined,{minimumFractionDigits:2, maximumFractionDigits:2}); 
}

async function qzPlainTest() {
  await qz.websocket.connect();

  const cfg = qz.configs.create("XP-80C");
const cutPartial = "\x1D\x56\x01";
 const feed5 = "\x1B\x64\x05";   

  // IMPORTANT: Avoid ₦ for now (many printers drop it). Use NGN.
  const receipt =
    "MACHAR OIL & GAS LTD\r\n" +
    "Machar POS Receipt\r\n" +
    "------------------------------------------\r\n" +
    "Receipt: 12345\r\n" +
    "Date:    2026-03-04 09:12\r\n" +
    "Customer: Walk-in\r\n" +
    "Payment: Cash\r\n" +
    "------------------------------------------\r\n" +
    "LPG Refill                     NGN 13,125.00\r\n" +
    "  12.50 x NGN 1,050.00\r\n" +
    "------------------------------------------\r\n" +
    "TOTAL                          NGN 13,125.00\r\n" +
    "\r\n" +
    "Thank you!\r\n\r\n\r\n";

  await qz.print(cfg, [{
    type: 'raw',
    format: 'plain',
data: receipt + feed5 + cutPartial
  }]);
}

  async function printThermal(){
    // Build sale data from Razor model into JS (safe minimal fields)
    const sale = {
      receiptNo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReceiptNo)),
      stationName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Station?.Name)),
      status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Status.ToString())),
      createdAtLocal: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))),
      customerName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Customer?.Name ?? "Walk-in")),
      paymentMethod: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethod.ToString())),
      subtotal: @Model.Subtotal,
      discountAmount: @Model.DiscountAmount,
      loyaltyDiscountAmount: @Model.LoyaltyDiscountAmount,
      total: @Model.Total,
     items: [
  @Html.Raw(string.Join(",",
    Model.Items.Select(it =>
      System.Text.Json.JsonSerializer.Serialize(new {
        name = it.Product?.Name,
        qty = it.Qty,
        lpgKg = it.LpgKg,
        unitPrice = it.UnitPrice,
        lineTotal = it.LineTotal
      })
    )
  ))
]
    };

    try {
      if (!qz.websocket.isActive()) {
      await qz.websocket.connect();
        console.log(await qz.printers.find());
      }

      // Choose the exact printer
      const config = qz.configs.create(THERMAL_PRINTER_NAME, {
        // Optional: add per-job options here if needed
      });

      const raw = buildReceiptText(sale);

      // QZ expects an array; send a single RAW payload
   for (let i = 0; i < 2; i++) {
  await qz.print(config, [{
    type: 'raw',
    format: 'plain',
    data: raw
  }]);
}
    } catch (e) {
      alert("Thermal print failed: " + (e.message || e));
      console.error(e);
    }
  }
</script>