@model List<MacharPos.Core.Entities.Customer>

@{
    ViewData["Title"] = "Customers";
    var stationName = (string)ViewBag.StationName;
    bool showInactive = (bool)ViewBag.ShowInactive;
    var search = (string)(ViewBag.Search ?? "");
    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var totalPages = (int)(ViewBag.TotalPages ?? 0);
    var hasPreviousPage = (bool)(ViewBag.HasPreviousPage ?? false);
    var hasNextPage = (bool)(ViewBag.HasNextPage ?? false);
    var sortBy = (string)(ViewBag.SortBy ?? "name");
    var sortDir = (string)(ViewBag.SortDir ?? "asc");

    string NextDir(string col) => sortBy == col && sortDir == "asc" ? "desc" : "asc";
    string SortIndicator(string col) => sortBy == col ? (sortDir == "asc" ? " ▲" : " ▼") : "";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h5 mb-0">Customers (@totalCount registered customers)</h1>
        <div class="text-secondary small">Station: <span class="fw-semibold">@stationName</span></div>
    </div>

    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
        {
            <a class="btn btn-dark btn-sm" asp-action="Create">Add Customer</a>
            <form asp-action="EnsureWalkIn" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-secondary btn-sm" type="submit">Ensure Walk-in</button>
            </form>
        }
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form class="row g-2 align-items-end" method="get">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="sortBy" value="@sortBy" />
            <input type="hidden" name="sortDir" value="@sortDir" />

            <div class="col-12 col-md-6">
                <label class="form-label">Search</label>
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Search by customer name or phone number" />
            </div>

            <div class="col-12 col-md-3">
                <div class="form-check mt-4">
                    <input class="form-check-input"
                           type="checkbox"
                           name="showInactive"
                           value="true"
                           @(showInactive ? "checked" : null) />
                    <label class="form-check-label">Show inactive</label>
                </div>
            </div>

            <div class="col-12 col-md-3 d-flex gap-2">
                <button class="btn btn-outline-primary w-100" type="submit">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>

        <div class="table-responsive mt-3">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>No</th>
                        <th>
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="name"
                               asp-route-sortDir="@NextDir("name")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Name@(SortIndicator("name"))
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="phone"
                               asp-route-sortDir="@NextDir("phone")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Phone@(SortIndicator("phone"))
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="address"
                               asp-route-sortDir="@NextDir("address")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Address@(SortIndicator("address"))
                            </a>
                        </th>
                        <th class="text-center">
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="stamps"
                               asp-route-sortDir="@NextDir("stamps")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Stamps@(SortIndicator("stamps"))
                            </a>
                        </th>
                        <th class="text-center">
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="redeemed"
                               asp-route-sortDir="@NextDir("redeemed")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Rewards Redeemed@(SortIndicator("redeemed"))
                            </a>
                        </th>
                        <th class="text-center">
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="rewards"
                               asp-route-sortDir="@NextDir("rewards")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Available Rewards@(SortIndicator("rewards"))
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="credit"
                               asp-route-sortDir="@NextDir("credit")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Credit@(SortIndicator("credit"))
                            </a>
                        </th>
                        <th class="text-end">
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="limit"
                               asp-route-sortDir="@NextDir("limit")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Limit@(SortIndicator("limit"))
                            </a>
                        </th>
                        <th>
                            <a class="text-decoration-none text-dark"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="status"
                               asp-route-sortDir="@NextDir("status")"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">
                                Status@(SortIndicator("status"))
                            </a>
                        </th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var index = ((currentPage - 1) * pageSize) + 1;
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td class="fw-semibold">@c.Name</td>
                                <td>@(c.Phone ?? "-")</td>
                                <td class="text-break">@(c.Address ?? "-")</td>

                                <td class="text-center">
                                    @if (c.IsLoyaltyEnabled)
                                    {
                                        <span class="badge text-bg-info">@c.LoyaltyStampCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (c.IsLoyaltyEnabled)
                                    {
                                        <span class="badge text-bg-dark">@c.LoyaltyLifetimeRedeemed</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (c.IsLoyaltyEnabled)
                                    {
                                        <span class="badge text-bg-success">@c.LoyaltyAvailableRewards</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (c.IsCreditApproved)
                                    {
                                        <span class="badge text-bg-primary">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">No</span>
                                    }
                                </td>

                                <td class="text-end">₦@c.CreditLimit.ToString("N2")</td>

                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge text-bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <a class="btn btn-outline-secondary btn-sm"
                                               asp-action="Edit"
                                               asp-route-id="@c.Id">Edit</a>

                                            @if (c.Name != "Walk-in")
                                            {
                                                <form asp-action="Toggle" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@c.Id" />
                                                    <button class="btn btn-outline-warning btn-sm" type="submit">Toggle</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-3">
                                No customers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-end mb-0">
                    <li class="page-item @(hasPreviousPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-showInactive="@showInactive"
                           asp-route-sortBy="@sortBy"
                           asp-route-sortDir="@sortDir"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-pageSize="@pageSize">Previous</a>
                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 2);
                        var endPage = Math.Min(totalPages, currentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="@sortBy"
                               asp-route-sortDir="@sortDir"
                               asp-route-page="1"
                               asp-route-pageSize="@pageSize">1</a>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="@sortBy"
                               asp-route-sortDir="@sortDir"
                               asp-route-page="@p"
                               asp-route-pageSize="@pageSize">@p</a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }

                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@search"
                               asp-route-showInactive="@showInactive"
                               asp-route-sortBy="@sortBy"
                               asp-route-sortDir="@sortDir"
                               asp-route-page="@totalPages"
                               asp-route-pageSize="@pageSize">@totalPages</a>
                        </li>
                    }

                    <li class="page-item @(hasNextPage ? "" : "disabled")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-showInactive="@showInactive"
                           asp-route-sortBy="@sortBy"
                           asp-route-sortDir="@sortDir"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-pageSize="@pageSize">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>