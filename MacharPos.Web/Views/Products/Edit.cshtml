@model MacharPos.Core.Entities.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Edit Product";
    var categories = (SelectList)ViewBag.Categories;
}
<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h5 mb-0">Edit Product</h1>
  <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <form method="post">
      @Html.AntiForgeryToken()
      <div class="mb-3">
        <label class="form-label">Category</label>
        <select class="form-select" asp-for="CategoryId" asp-items="categories"></select>
      </div>
      <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
      </div>
      <div class="mb-3">
        <label class="form-label">SKU</label>
        <input class="form-control" asp-for="Sku" />
      </div>
      <div class="row g-2">
        <div class="col-12 col-md-6">
          <label class="form-label">Default Unit Price</label>
          <input class="form-control" asp-for="DefaultUnitPrice" type="number" step="0.01" />
        </div>
        <div class="col-12 col-md-6">
          <label class="form-label">Equivalent Kg</label>
          <input class="form-control" asp-for="EquivalentKg" type="number" step="0.01" />
        </div>
      </div>
      <div class="form-check mt-3">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
        <label class="form-check-label">Active</label>
      </div>
      <button class="btn btn-dark w-100 mt-3">Save Changes</button>
    </form>
  </div>
</div>