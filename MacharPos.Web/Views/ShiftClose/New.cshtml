@model MacharPos.Web.ViewModels.ShiftClose.ShiftCloseCreateVm

@{
    ViewData["Title"] = "Start Shift";
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h5 mb-0">Start Shift</h1>
    <div class="text-secondary small">Creates an OPEN shift for mid-day reconciliation.</div>
  </div>
  <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <form method="post">
      @Html.AntiForgeryToken()

      <div class="row g-2">
        <div class="col-12 col-md-4">
          <label class="form-label">Shift Name</label>
          <input class="form-control" asp-for="ShiftName" placeholder="Morning / Evening / Night" />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Shift Date</label>
          <input class="form-control" asp-for="ShiftDate" type="date" />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Hand Over To (optional)</label>
          <input class="form-control" asp-for="HandedOverTo" placeholder="Next shift staff name" />
        </div>
      </div>

      <div class="mt-3">
        <label class="form-label">Notes (optional)</label>
        <textarea class="form-control" asp-for="Notes" rows="2"></textarea>
      </div>

      <button class="btn btn-dark w-100 mt-3">Start Shift</button>
    </form>
  </div>
</div>
