@model List<MacharPos.Core.Entities.Sale>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Credit Ledger";
    var customers = (List<SelectListItem>)ViewBag.Customers;
    bool showSettled = (bool)ViewBag.ShowSettled;
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h5 mb-0">Credit Ledger</h1>
    <div class="text-secondary small">Open credit sales, payments, and balances</div>
  </div>
  @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
  {
    <a class="btn btn-dark btn-sm" asp-action="New">New Credit Sale</a>
  }
</div>

@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Err"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card shadow-sm mb-3">
  <div class="card-body">
    <form method="get" class="row g-2 align-items-end">
      <div class="col-12 col-md-6">
        <label class="form-label">Customer</label>
        <select class="form-select" name="customerId" asp-items="customers">
          <option value="">All customers</option>
        </select>
      </div>
      <div class="col-12 col-md-3">
        <div class="form-check mt-4">
          <input class="form-check-input" type="checkbox" name="showSettled" value="true" @(showSettled ? "checked" : "") />
          <label class="form-check-label">Show settled</label>
        </div>
      </div>
      <div class="col-12 col-md-3">
        <button class="btn btn-outline-primary w-100">Apply</button>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Date</th>
            <th>Receipt</th>
            <th>Customer</th>
            <th class="text-end">Total</th>
            <th class="text-end">Paid</th>
            <th class="text-end">Balance</th>
            <th>Status</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var s in Model)
          {
            <tr>
              <td>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
              <td class="fw-semibold">@s.ReceiptNo</td>
              <td>@(s.Customer?.Name ?? "Walk-in")</td>
              <td class="text-end">@s.Total.ToString("N2")</td>
              <td class="text-end">@s.CreditAmountPaid.ToString("N2")</td>
              <td class="text-end">@s.CreditBalance.ToString("N2")</td>
              <td>
                @if (s.CreditBalance <= 0) { <span class="badge text-bg-success">Settled</span> }
                else { <span class="badge text-bg-warning">Open</span> }
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-2">
                  <a class="btn btn-outline-secondary btn-sm" asp-action="Receipt" asp-route-id="@s.Id">Receipt</a>
                  @if ((User.IsInRole("Admin") || User.IsInRole("StationManager")) && s.CreditBalance > 0)
                  {
                    <a class="btn btn-outline-success btn-sm" asp-action="AddPayment" asp-route-id="@s.Id">Add Payment</a>
                  }
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>