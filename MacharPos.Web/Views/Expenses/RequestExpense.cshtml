@using MacharPos.Core.Entities
@using MacharPos.Web.Services.Expenses
@model MacharPos.Web.ViewModels.Expenses.ExpenseRequestPageVm

@{
    ViewData["Title"] = "Expense Request";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">Expense Request</h1>
        <div class="text-secondary">Submit an expense for administrator approval and track its status.</div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-dark" asp-action="Manage">Manage requests</a>
            <a class="btn btn-outline-danger" asp-action="Report">Expense reports</a>
        </div>
    }
</div>

@if (TempData["Ok"] is not null)
{
    <div class="alert alert-success">@TempData["Ok"]</div>
}
@if (TempData["Err"] is not null)
{
    <div class="alert alert-danger">@TempData["Err"]</div>
}

<div class="row g-3">
    <div class="col-12 col-xl-5">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h2 class="h6 mb-0">New request</h2>
            </div>
            <div class="card-body">
                <form asp-action="RequestExpense" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Form.ExpenseDateTimeLocal" class="form-label"></label>
                        <input asp-for="Form.ExpenseDateTimeLocal"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="Form.ExpenseDateTimeLocal" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.Amount" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₦</span>
                                <input asp-for="Form.Amount" type="number" min="0.01" step="0.01" class="form-control" />
                            </div>
                            <span asp-validation-for="Form.Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-12 col-md-6">
                            <label asp-for="Form.Category" class="form-label"></label>
                            <select asp-for="Form.Category"
                                    asp-items="Html.GetEnumSelectList<ExpenseCategory>()"
                                    class="form-select"></select>
                            <span asp-validation-for="Form.Category" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Reason" class="form-label"></label>
                        <textarea asp-for="Form.Reason" rows="4" maxlength="500" class="form-control"
                                  placeholder="Describe what the expense is for"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Form.Reason" class="text-danger small"></span>
                            <span class="form-text">Maximum 500 characters</span>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3 bg-light-subtle">
                        <div class="fw-semibold mb-1">Proof of expense <span class="text-secondary fw-normal">(optional)</span></div>
                        <div class="text-secondary small mb-3">Add one image or PDF, up to 10 MB.</div>

                        <div class="mb-3">
                            <label asp-for="Form.EvidenceFile" class="form-label small fw-semibold"></label>
                            <input asp-for="Form.EvidenceFile"
                                   type="file"
                                   accept=".jpg,.jpeg,.png,.webp,.heic,.heif,.pdf,image/jpeg,image/png,image/webp,image/heic,image/heif,application/pdf"
                                   class="form-control" />
                        </div>

                        <div>
                            <label asp-for="Form.EvidencePhoto" class="form-label small fw-semibold"></label>
                            <input asp-for="Form.EvidencePhoto"
                                   type="file"
                                   accept="image/*"
                                   capture="environment"
                                   class="form-control" />
                        </div>

                        <span asp-validation-for="Form.EvidenceFile" class="text-danger small d-block mt-2"></span>
                        <span asp-validation-for="Form.EvidencePhoto" class="text-danger small d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Submit for approval</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">My recent requests</h2>
                <span class="badge text-bg-light">Latest 100</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 expense-table">
                        <thead class="table-light">
                            <tr>
                                <th>Date / time</th>
                                <th>Details</th>
                                <th>Status</th>
                                <th class="text-end">Amount</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MyRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-secondary py-5">No expense requests have been submitted yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.MyRequests)
                                {
                                    <tr>
                                        <td class="text-nowrap">
                                            <div class="fw-semibold">@item.ExpenseDateTimeLocal.ToString("dd MMM yyyy")</div>
                                            <div class="text-secondary small">@item.ExpenseDateTimeLocal.ToString("HH:mm") WAT</div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@ExpenseReporting.CategoryName(item.Category)</div>
                                            <div class="text-secondary small expense-reason">@item.Reason</div>
                                            @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                                            {
                                                <div class="small mt-1"><span class="fw-semibold">Admin note:</span> @item.ReviewNote</div>
                                            }
                                        </td>
                                        <td>
                                            @if (item.Status == ExpenseStatus.Approved)
                                            {
                                                <span class="badge text-bg-success">Approved</span>
                                                @if (item.PaymentStatus == ExpensePaymentStatus.Paid)
                                                {
                                                    <span class="badge text-bg-dark">Paid</span>
                                                }
                                                else if (item.PaymentStatus == ExpensePaymentStatus.Cancelled)
                                                {
                                                    <span class="badge text-bg-secondary">Payment cancelled</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-primary">Awaiting payment</span>
                                                }
                                            }
                                            else if (item.Status == ExpenseStatus.Rejected)
                                            {
                                                <span class="badge text-bg-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td class="text-end fw-semibold text-nowrap">₦@item.Amount.ToString("N2")</td>
                                        <td class="text-end">
                                            @if (item.HasEvidence)
                                            {
                                                <a class="btn btn-outline-secondary btn-sm"
                                                   asp-action="Evidence" asp-route-id="@item.Id">Proof</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
