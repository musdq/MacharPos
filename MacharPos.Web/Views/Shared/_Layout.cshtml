@using Microsoft.AspNetCore.Identity
@inject SignInManager<MacharPos.Web.Auth.ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Machar POS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (SignInManager.IsSignedIn(User))
    {
        <header class="no-print">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom">
                <div class="container-fluid">
                    <a class="navbar-brand fw-semibold" asp-controller="Dashboard" asp-action="Index">Machar POS</a>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a>></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="New">New Sale</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Index">Sales</a></li>                      
                          

                            @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="ProductCategories" asp-action="Index">Categories</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Batches" asp-action="Index">Batches</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Credit" asp-action="New">New Credit Sale</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Credit" asp-action="Index">Credit Sales</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Credit" asp-action="Aging">Credit Aging</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="DailyClose" asp-action="Index">Daily Close</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="ShiftClose" asp-action="Index">Shift Close</a></li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                                <li class="nav-item"><a class="nav-link" href="/hq/dashboard">HQ Dashboard</a></li>
                            }
                            

                        </ul>

                        <div class="d-flex gap-2 align-items-center">
                            <span class="text-light small">@User.Identity?.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light btn-sm">Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main class="container-fluid py-3">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
