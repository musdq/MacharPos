@{
    ViewData["Title"] = "About Us";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">About us</span>
        <h1>About Machar Oil and Gas Ltd</h1>
        <p>Empowering communities and businesses with reliable energy solutions.</p>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <h2>Who We Are</h2>
                <p>Machar Oil and Gas Ltd is a dynamic and fast-growing player in Nigeria's energy sector. We specialize in the logistics, retail, and consulting of PMS, LPG, and AGO. Our operations are driven by a commitment to reliability, safety, and innovation.</p>
                <p>We aim to be a trusted partner for individuals, businesses, and organizations by delivering exceptional services and energy solutions that power growth and development.</p>
            </div>
            <div class="col-lg-6">
                <div class="values-panel">
                    <div>
                        <h3>Our Mission</h3>
                        <p>To provide high-quality energy solutions through efficient logistics, trusted retail operations, and expert consulting services that empower communities and businesses across Nigeria.</p>
                    </div>
                    <div>
                        <h3>Our Vision</h3>
                        <p>To become a leading energy company recognized for reliability, innovation, and sustainable practices that contribute to Africa's energy future.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="public-section section-muted">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Our standards</span>
            <h2>Our Core Values</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4"><div class="service-card"><h3>Integrity</h3><p>We uphold high standards of ethics, accountability, and transparency in everything we do.</p></div></div>
            <div class="col-md-4"><div class="service-card"><h3>Innovation</h3><p>We embrace modern technologies and practical systems to deliver better customer outcomes.</p></div></div>
            <div class="col-md-4"><div class="service-card"><h3>Teamwork</h3><p>We work closely with partners, staff, and customers to achieve shared success.</p></div></div>
        </div>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <div class="metrics-grid">
            <div><strong>30+</strong><span>Dedicated Staff</span></div>
            <div><strong>4</strong><span>Logistics Trucks</span></div>
            <div><strong>2</strong><span>Retail Locations</span></div>
            <div><strong>10+</strong><span>Years Combined Experience</span></div>
        </div>
    </div>
</section>
