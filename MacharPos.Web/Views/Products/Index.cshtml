@model List<MacharPos.Core.Entities.Product>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Products";
    var categories = (SelectList)ViewBag.Categories;
    var stations = (SelectList)ViewBag.Stations;
    Guid? categoryId = (Guid?)ViewBag.CategoryId;
    Guid? stationId = (Guid?)ViewBag.StationId;
    bool showInactive = (bool)ViewBag.ShowInactive;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h5 mb-0">Products</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-controller="ProductCategories" asp-action="Index">Categories</a>
        <a class="btn btn-dark btn-sm" asp-action="Create">Add Product</a>
    </div>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">Station</label>
                <select class="form-select" name="stationId" asp-items="stations">
                    <option value="">All stations</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">Category</label>
                <select class="form-select" name="categoryId" asp-items="categories">
                    <option value="">All categories</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="showInactive" value="true" @(showInactive ? "checked" : "") />
                    <label class="form-check-label">Show inactive</label>
                </div>
            </div>
            <div class="col-12 col-md-2">
                <button class="btn btn-outline-primary w-100" type="submit">Filter</button>
            </div>
        </form>

        <form asp-action="BulkUpdatePrices" method="post" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="categoryId" value="@categoryId" />
            <input type="hidden" name="stationId" value="@stationId" />
            <input type="hidden" name="showInactive" value="@showInactive" />

            <div class="col-12 col-md-4">
                <label for="pricePerKg" class="form-label">LPG Price per Kg</label>
                <input type="number" step="0.01" min="0.01" name="pricePerKg" id="pricePerKg" class="form-control" placeholder="e.g. 1035" required />
            </div>
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-danger">Update Selected Station Prices</button>
            </div>
            @if (!stationId.HasValue)
            {
                <div class="col-12">
                    <small class="text-muted">Select a station above before running a bulk price update.</small>
                </div>
            }
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Station</th>
                        <th>Category</th>
                        <th>Name</th>
                        <th class="text-end">Default Price</th>
                        <th class="text-end">Kg (if LPG)</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Station?.Name</td>
                            <td>@product.Category?.Name</td>
                            <td class="text-break">@product.Name</td>
                            <td class="text-end">@product.DefaultUnitPrice.ToString("N2")</td>
                            <td class="text-end">@((product.EquivalentKg ?? 0m) == 0m ? "-" : product.EquivalentKg!.Value.ToString("N2"))</td>
                            <td>
                                @if (product.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                                <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
