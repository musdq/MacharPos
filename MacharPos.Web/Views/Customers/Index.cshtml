@model List<MacharPos.Core.Entities.Customer>

@{
    ViewData["Title"] = "Customers";
    var stationName = (string)ViewBag.StationName;
    bool showInactive = (bool)ViewBag.ShowInactive;
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h5 mb-0">Customers</h1>
    <div class="text-secondary small">Station: <span class="fw-semibold">@stationName</span></div>
  </div>

  <div class="d-flex gap-2">
    @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
    {
      <a class="btn btn-dark btn-sm" asp-action="Create">Add Customer</a>
      <form asp-action="EnsureWalkIn" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button class="btn btn-outline-secondary btn-sm" type="submit">Ensure Walk-in</button>
      </form>
    }
  </div>
</div>

@if (TempData["Ok"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Err"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card shadow-sm">
  <div class="card-body">
    <form class="row g-2 align-items-end" method="get">
      <div class="col-12 col-md-9">
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" name="showInactive" value="true" @(showInactive ? "checked" : "") />
          <label class="form-check-label">Show inactive</label>
        </div>
      </div>
      <div class="col-12 col-md-3">
        <button class="btn btn-outline-primary w-100">Apply</button>
      </div>
    </form>

    <div class="table-responsive mt-3">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Credit</th>
            <th class="text-end">Limit</th>
            <th>Status</th>
            <th class="text-end"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var c in Model)
          {
            <tr>
              <td class="fw-semibold">@c.Name</td>
              <td>@(c.Phone ?? "-")</td>
              <td class="text-break">@(c.Address ?? "-")</td>
              <td>
                @if (c.IsCreditApproved)
                {
                  <span class="badge text-bg-primary">Approved</span>
                }
                else
                {
                  <span class="badge text-bg-secondary">No</span>
                }
              </td>
              <td class="text-end">₦@c.CreditLimit.ToString("N2")</td>
              <td>
                @if (c.IsActive) { <span class="badge text-bg-success">Active</span> }
                else { <span class="badge text-bg-secondary">Inactive</span> }
              </td>
              <td class="text-end">
                @if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
                {
                  <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@c.Id">Edit</a>
                    @if (c.Name != "Walk-in")
                    {
                      <form asp-action="Toggle" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@c.Id" />
                        <button class="btn btn-outline-warning btn-sm" type="submit">Toggle</button>
                      </form>
                    }
                  </div>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>