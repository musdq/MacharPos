@model MacharPos.Web.ViewModels.Customers.CustomerEditVm
@{
    ViewData["Title"] = "Add Customer";
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <h1 class="h5 mb-0">Add Customer</h1>
  <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
  <div class="alert alert-danger">
    @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
      <div>@e.ErrorMessage</div>
    }
  </div>
}

<div class="card shadow-sm">
  <div class="card-body">
    <form method="post">
      @Html.AntiForgeryToken()

      <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
      </div>

      <div class="mb-3">
        <label class="form-label">Phone (optional)</label>
        <input class="form-control" asp-for="Phone" />
      </div>

      <div class="mb-3">
        <label class="form-label">Address (optional)</label>
        <input class="form-control" asp-for="Address" />
      </div>

      <hr class="my-3" />
      <div class="fw-semibold mb-2">Credit Controls (Optional)</div>

      <div class="row g-2">
        <div class="col-12 col-md-4">
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" asp-for="IsCreditApproved" />
            <label class="form-check-label">Credit Approved</label>
          </div>
          <div class="form-text">Only approved customers can be used for credit sales.</div>
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Credit Limit (₦)</label>
          <input class="form-control" asp-for="CreditLimit" type="number" step="0.01" value="0" />
        </div>
        <div class="col-12 col-md-4">
          <label class="form-label">Due Days</label>
          <input class="form-control" asp-for="CreditDueDays" type="number" step="1" value="0" />
          <div class="form-text">Auto-calculates due date on credit sale.</div>
        </div>
      </div>

      <div class="form-check">
        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
        <label class="form-check-label">Active</label>
      </div>

      <button class="btn btn-dark w-100 mt-3">Save</button>
    </form>
  </div>
</div>