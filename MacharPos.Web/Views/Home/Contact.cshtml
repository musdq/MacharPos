@{
    ViewData["Title"] = "Contact";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Contact</span>
        <h1>Contact Us</h1>
        <p>We’re here to help you with your energy needs.</p>
    </div>
</section>

<section class="public-section">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5">
                <h2>Get In Touch</h2>
                <p>We’re ready to answer your questions and discuss your supply, logistics, retail, or consulting needs.</p>
                <div class="contact-list">
                    <div><strong>Address:</strong><span>Opposite CBN Quarters, Maiduguri, Borno State, Nigeria</span>
                        <br />
                        <hr/>
                        <span>Opposite Mewar International University, Kuchikau, Masaka, Nassarawa State, Nigeria</span>
                    </div>
                    <div><strong>Phone: </strong><span>+234 707 8017 744</span></div>
                    <div><strong>Email: </strong><span>info@macharoilandgasltd.com</span></div>
                    <div><strong>Business Hours: </strong><span>Monday – Sunday: 8:00 AM – 8:00 PM</span></div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="contact-form-card">
                    <h2>Send Us a Message</h2>
                    <form>
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Name</label><input class="form-control" type="text" /></div>
                            <div class="col-md-6"><label class="form-label">Phone / Email</label><input class="form-control" type="text" /></div>
                            <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="5"></textarea></div>
                        </div>
                        <button type="button" class="btn btn-primary mt-3">Send Message</button>
                        <p class="form-note">This form is ready for future backend wiring. For now, customers can contact the company directly using the details shown.</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
