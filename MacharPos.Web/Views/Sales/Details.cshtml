@model MacharPos.Core.Entities.Sale

@{
    ViewData["Title"] = "Sale Details";
}

<div class="d-flex align-items-center justify-content-between mb-3">
  <div>
    <h1 class="h5 mb-0">Sale Details</h1>
    <div class="text-secondary small">Receipt: <span class="fw-semibold">@Model.ReceiptNo</span></div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Receipt" asp-route-id="@Model.Id">Receipt</a>
  </div>
</div>

@if (TempData["Ok"] is string ok)
{
  <div class="alert alert-success">@ok</div>
}
@if (TempData["Err"] is string err)
{
  <div class="alert alert-danger">@err</div>
}

<div class="card shadow-sm">
  <div class="card-body">
    <div class="row g-2">
      <div class="col-12 col-md-4">
        <div class="text-secondary small">Date</div>
        <div class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
      </div>
      <div class="col-12 col-md-4">
        <div class="text-secondary small">Customer</div>
        <div class="fw-semibold">@(Model.Customer?.Name ?? "Walk-in")</div>
      </div>
      <div class="col-12 col-md-4">
        <div class="text-secondary small">Payment</div>
        <div class="fw-semibold">@Model.PaymentMethod</div>
      </div>
    </div>

    <hr class="my-3" />

    <div class="d-flex align-items-center justify-content-between">
      <div class="fw-semibold">Items</div>
      <div>
        @if (Model.Status == MacharPos.Core.Entities.SaleStatus.Voided)
        {
          <span class="badge text-bg-danger">VOID</span>
        }
        else
        {
          <span class="badge text-bg-success">OK</span>
        }
      </div>
    </div>

    <div class="table-responsive mt-2">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Item</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Unit</th>
            <th class="text-end">Total</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var it in Model.Items)
          {
            <tr>
              <td>
                <div class="fw-semibold">@it.Product?.Name</div>
                @if ((it.LpgKg ?? 0m) > 0m)
                {
                  <div class="text-secondary small">LPG: @it.LpgKg.Value.ToString("N2") kg</div>
                }
              </td>
              <td class="text-end">@it.Qty.ToString("N2")</td>
              <td class="text-end">@it.UnitPrice.ToString("N2")</td>
              <td class="text-end">@it.LineTotal.ToString("N2")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-end mt-2">
      <div class="fs-6">
        Total: <span class="fw-semibold">₦@Model.Total.ToString("N2")</span>
      </div>
    </div>

    @if (Model.Status == MacharPos.Core.Entities.SaleStatus.Voided)
    {
      <hr class="my-3" />
      <div class="alert alert-warning mb-0">
        <div class="fw-semibold">Voided</div>
        <div class="small">Reason: @Model.VoidReason</div>
        <div class="small text-secondary">At: @Model.VoidedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
      </div>
    }
    else if (User.IsInRole("Admin") || User.IsInRole("StationManager"))
    {
      <hr class="my-3" />
      <form asp-action="Void" method="post" class="row g-2">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="col-12 col-md-8">
          <label class="form-label">Void Reason</label>
          <input class="form-control" name="reason" placeholder="e.g. Wrong product / duplicate sale / customer cancelled" />
        </div>
        <div class="col-12 col-md-4 d-flex align-items-end">
          <button class="btn btn-outline-danger w-100" type="submit"
                  onclick="return confirm('Void this sale? This will revert LPG batch sold kg where applicable.');">
            Void Sale
          </button>
        </div>
      </form>
    }
  </div>
</div>
