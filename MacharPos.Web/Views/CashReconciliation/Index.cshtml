@model MacharPos.Web.ViewModels.Finance.CashReconciliationVm

@{ ViewData["Title"] = "Cash Reconciliation"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3"><div><h1 class="h4 mb-1">Daily Cash Reconciliation</h1><div class="text-secondary">Count main cash and petty cash against the expected balances from the cashbook.</div></div><div class="d-flex gap-2"><a class="btn btn-outline-dark" asp-controller="Cashbook" asp-action="Index" asp-route-period="daily" asp-route-startDate="@Model.ReconciliationDate.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.ReconciliationDate.ToString("yyyy-MM-dd")" asp-route-stationId="@Model.StationId">Open cashbook</a><a class="btn btn-outline-dark" asp-controller="DailyClose" asp-action="Index" asp-route-date="@Model.ReconciliationDate.ToString("yyyy-MM-dd")">Daily close</a></div></div>

@if (TempData["Ok"] is not null) { <div class="alert alert-success">@TempData["Ok"]</div> }
@if (TempData["Err"] is not null) { <div class="alert alert-danger">@TempData["Err"]</div> }

<div class="card shadow-sm mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end">@if (Model.IsAdmin) { <div class="col-12 col-md-5"><label class="form-label">Station</label><select name="stationId" class="form-select">@foreach (var station in Model.Stations) { <option value="@station.Id" selected="@(Model.StationId == station.Id)">@station.Name</option> }</select></div> }<div class="col-12 col-md-4"><label class="form-label">Business date</label><input type="date" name="date" class="form-control" value="@Model.ReconciliationDate.ToString("yyyy-MM-dd")" /></div><div class="col-12 col-md-3"><button class="btn btn-outline-dark w-100">Load day</button></div></form></div></div>

@if (Model.IsClosed) { <div class="alert alert-success d-flex flex-wrap justify-content-between gap-2"><div><strong>Closed reconciliation.</strong> Snapshot saved by @(Model.ClosedBy ?? "user") at @(Model.ClosedAtLocal?.ToString("dd MMM yyyy, HH:mm") ?? "—") WAT.</div>@if (Model.IsAdmin) { <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#reopenModal">Reopen</button> }</div> }
else { <div class="alert alert-warning"><strong>Open reconciliation.</strong> Expected values are live and will be snapshotted when you close the day.</div> }

<div class="row g-3 mb-3"><div class="col-12 col-lg-6"><div class="card shadow-sm h-100"><div class="card-header bg-dark text-white">Main cash</div><div class="card-body"><dl class="row mb-0"><dt class="col-7">Opening balance</dt><dd class="col-5 text-end">₦@Model.OpeningMainCash.ToString("N2")</dd><dt class="col-7">Cash sales</dt><dd class="col-5 text-end text-success">+₦@Model.CashSales.ToString("N2")</dd><dt class="col-7">Cash credit collections</dt><dd class="col-5 text-end text-success">+₦@Model.CashCreditCollections.ToString("N2")</dd><dt class="col-7">Manual movements (net)</dt><dd class="col-5 text-end">₦@Model.ManualMainCashNet.ToString("N2")</dd><dt class="col-7">Paid cash expenses</dt><dd class="col-5 text-end text-danger">−₦@Model.PaidMainCashExpenses.ToString("N2")</dd><dt class="col-7 border-top pt-2">Expected main cash</dt><dd class="col-5 text-end border-top pt-2 fw-bold">₦@Model.ExpectedMainCash.ToString("N2")</dd></dl></div></div></div>
<div class="col-12 col-lg-6"><div class="card shadow-sm h-100"><div class="card-header bg-danger text-white">Petty cash</div><div class="card-body"><dl class="row mb-0"><dt class="col-7">Opening balance</dt><dd class="col-5 text-end">₦@Model.OpeningPettyCash.ToString("N2")</dd><dt class="col-7">Manual movements / top-ups</dt><dd class="col-5 text-end">₦@Model.ManualPettyCashNet.ToString("N2")</dd><dt class="col-7">Paid petty-cash expenses</dt><dd class="col-5 text-end text-danger">−₦@Model.PaidPettyCashExpenses.ToString("N2")</dd><dt class="col-7 border-top pt-2">Expected petty cash</dt><dd class="col-5 text-end border-top pt-2 fw-bold">₦@Model.ExpectedPettyCash.ToString("N2")</dd></dl></div></div></div></div>

<div class="card shadow-sm"><div class="card-header bg-white py-3"><div class="fw-semibold">Physical cash count — @Model.StationName</div><div class="small text-secondary">Combined expected cash on hand: ₦@Model.ExpectedTotal.ToString("N2")</div></div><div class="card-body">
@if (!Model.IsClosed)
{
    <form asp-action="Close" method="post" class="row g-3">@Html.AntiForgeryToken()<input type="hidden" name="stationId" value="@Model.StationId" /><input type="hidden" name="reconciliationDate" value="@Model.ReconciliationDate.ToString("yyyy-MM-dd")" /><div class="col-12 col-md-4"><label class="form-label">Actual main cash counted</label><input type="number" name="actualMainCash" min="0" step="0.01" class="form-control" value="@Model.ActualMainCash?.ToString("0.00")" required /></div><div class="col-12 col-md-4"><label class="form-label">Actual petty cash counted</label><input type="number" name="actualPettyCash" min="0" step="0.01" class="form-control" value="@Model.ActualPettyCash?.ToString("0.00")" required /></div><div class="col-12"><label class="form-label">Notes</label><textarea name="notes" maxlength="1000" rows="3" class="form-control">@Model.Notes</textarea></div><div class="col-12"><button class="btn btn-danger" onclick="return confirm('Close and snapshot this cash reconciliation?');">Close reconciliation</button></div></form>
}
else
{
    <div class="row g-3"><div class="col-6 col-md-3"><div class="small text-secondary">Actual main</div><div class="h5">₦@Model.ActualMainCash?.ToString("N2")</div></div><div class="col-6 col-md-3"><div class="small text-secondary">Main variance</div><div class="h5 @(Model.MainCashVariance == 0 ? "text-success" : "text-danger")">₦@Model.MainCashVariance?.ToString("N2")</div></div><div class="col-6 col-md-3"><div class="small text-secondary">Actual petty</div><div class="h5">₦@Model.ActualPettyCash?.ToString("N2")</div></div><div class="col-6 col-md-3"><div class="small text-secondary">Petty variance</div><div class="h5 @(Model.PettyCashVariance == 0 ? "text-success" : "text-danger")">₦@Model.PettyCashVariance?.ToString("N2")</div></div></div>@if (!string.IsNullOrWhiteSpace(Model.Notes)) { <hr /><div><span class="fw-semibold">Notes:</span> @Model.Notes</div> }
}
</div></div>

@if (Model.IsAdmin && Model.IsClosed)
{
<div class="modal fade" id="reopenModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="Reopen" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="modal-title fs-5">Reopen reconciliation</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="stationId" value="@Model.StationId" /><input type="hidden" name="reconciliationDate" value="@Model.ReconciliationDate.ToString("yyyy-MM-dd")" /><label class="form-label">Reason</label><textarea name="reason" minlength="3" maxlength="500" class="form-control" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger">Reopen</button></div></form></div></div></div>
}
